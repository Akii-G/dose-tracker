_style = {"provider": None}


def _load(provider, css):
    try:
        provider.load_from_string(css)          # GTK 4.12 and newer
    except AttributeError:
        provider.load_from_data(css.encode("utf-8"))


def apply_style(name=None):
    """Switch the look of every Dose window: 'default' or 'tahoe', in the chosen colour tone."""
    name = name or prefs()["style"]
    display = Gdk.Display.get_default()
    if display is None:
        return
    if _style.get("base") is None:
        _style["base"] = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(display, _style["base"], Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    _load(_style["base"], toned(CSS))
    # the calendar's colours above everything, the user's own gtk.css theme included
    if _style.get("days") is None:
        _style["days"] = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(display, _style["days"], Gtk.STYLE_PROVIDER_PRIORITY_USER + 2)
    _load(_style["days"], toned(DAY_CSS))
    if _style["provider"] is not None:
        Gtk.StyleContext.remove_provider_for_display(display, _style["provider"])
        _style["provider"] = None
    if name != "tahoe":
        return
    provider = Gtk.CssProvider()
    _load(provider, toned(_TAHOE_DARK if Adw.StyleManager.get_default().get_dark() else _TAHOE_LIGHT))
    # above ~/.config/gtk-4.0/gtk.css, where many system themes put their rules
    Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
    _style["provider"] = provider


UNIT_ICONS = ("pill", "capsule", "drop", "ml", "puff", "sachet", "patch", "injection", "application")


def unit_icon(unit):
    """The kind of medicine as a small icon in a tinted circle (data/icons, tools/make_icons.py)."""
    image = Gtk.Image(icon_name="dose-unit-%s-symbolic" % (unit if unit in UNIT_ICONS else "pill"), pixel_size=18)
    box = Gtk.CenterBox(valign=Gtk.Align.CENTER, halign=Gtk.Align.START, hexpand=False)
    box.set_size_request(34, 34)
    box.set_center_widget(image)
    box.add_css_class("dose-unit")
    return box


def make_label(text, css=None, xalign=0.0, wrap=False, **kw):
    lab = Gtk.Label(label=text, xalign=xalign, wrap=wrap, **kw)
    for c in (css or "").split():
        lab.add_css_class(c)
    return lab


def clear(box):
    child = box.get_first_child()
    while child:
        nxt = child.get_next_sibling()
        box.remove(child)
        child = nxt


def med_title(med):
    return med["name"] + (" " + med["strength"] if med["strength"] else "")


class TimeEntry(Gtk.Box):
    """Hours and minutes, two spin buttons."""

    def __init__(self, value="08:00"):
        super().__init__(spacing=4)
        self.add_css_class("dose-time")
        self.h = Gtk.SpinButton.new_with_range(0, 23, 1)
        self.m = Gtk.SpinButton.new_with_range(0, 59, 5)
        for spin in (self.h, self.m):
            spin.set_wrap(True)
            spin.set_numeric(True)
            spin.connect("output", self.two_digits)
        self.append(self.h)
        self.append(make_label(":"))
        self.append(self.m)
        self.set_value(value)

    @staticmethod
    def two_digits(spin):
        spin.set_text("%02d" % spin.get_value_as_int())
        return True

    def set_value(self, value):
        self.h.set_value(int(value[:2]))
        self.m.set_value(int(value[3:5]))

    def get_value(self):
        return "%02d:%02d" % (self.h.get_value_as_int(), self.m.get_value_as_int())


class DateButton(Gtk.MenuButton):
    """A date, chosen on a calendar in a popover."""

    def __init__(self, day=None, empty_label=None):
        super().__init__()
        self.empty_label = empty_label
        self.calendar = Gtk.Calendar()
        pop = Gtk.Popover()
        pop.set_child(self.calendar)
        self.set_popover(pop)
        self.day = None
        self.calendar.connect("day-selected", self.on_pick)
        self.set_day(day)

    def set_day(self, day):
        self.day = day
        if day:
            self.calendar.select_day(GLib.DateTime.new_local(day.year, day.month, day.day, 12, 0, 0))
        self.set_label(fmt_date(day) if day else (self.empty_label or ""))

    def on_pick(self, cal):
        d = cal.get_date()
        self.day = dt.date(d.get_year(), d.get_month(), d.get_day_of_month())
        self.set_label(fmt_date(self.day))
        self.get_popover().popdown()


class DoseRow(Gtk.ListBoxRow):
    """One scheduled dose: name, amount and time, and Taken / Skip, or what was done."""

    def __init__(self, win, day, time_, med, dose):
        super().__init__(activatable=False)
        self.win, self.day, self.time, self.med = win, day, time_, med
        box = Gtk.Box(spacing=12, margin_top=10, margin_bottom=10, margin_start=14, margin_end=10)
        box.append(unit_icon(med["unit"]))
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
        text.append(make_label(med_title(med), "heading", ellipsize=3))
        sub = fmt_amount(amount_at(med, time_), med["unit"])
        if med["note"]:
            sub += " · " + med["note"]
        text.append(make_label(sub, "dim-label caption", ellipsize=3))
        box.append(text)
        if dose:
            word = (tr("Taken at %s") if dose["status"] == "taken" else tr("Skipped")) % dose["at"] \
                if dose["status"] == "taken" else tr("Skipped")
            box.append(make_label(word, "dose-taken" if dose["status"] == "taken" else "dose-skipped"))
            undo = Gtk.Button(icon_name="edit-undo-symbolic", valign=Gtk.Align.CENTER, tooltip_text=tr("Undo"))
            undo.add_css_class("flat")
            undo.connect("clicked", lambda *_: win.change(lambda s: s.unmark(dose["id"])))
            box.append(undo)
        else:
            late = day < today() or (day == today() and dt.datetime.now().strftime("%H:%M") > time_)
            if late:
                box.append(make_label(tr("Not taken"), "dose-late caption"))
            skip = Gtk.Button(label=tr("Skip"), valign=Gtk.Align.CENTER)
            skip.connect("clicked", lambda *_: self.mark("skipped"))
            taken = Gtk.Button(label=tr("Taken"), valign=Gtk.Align.CENTER)
            taken.add_css_class("suggested-action")
            taken.connect("clicked", lambda *_: self.mark("taken"))
            other = Gtk.MenuButton(icon_name="view-more-symbolic", valign=Gtk.Align.CENTER,
                                   tooltip_text=tr("Taken at another time"))
            other.add_css_class("flat")
            pop = Gtk.Popover()
            pbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=10, margin_bottom=10,
                           margin_start=10, margin_end=10)
            pbox.append(make_label(tr("Taken at"), "heading"))
            entry = TimeEntry(time_)
            pbox.append(entry)
            ok = Gtk.Button(label=tr("Mark as taken"))
            ok.add_css_class("suggested-action")
            ok.connect("clicked", lambda *_: (pop.popdown(), self.mark("taken", entry.get_value())))
            pbox.append(ok)
            pop.set_child(pbox)
            other.set_popover(pop)
            for w in (skip, taken, other):
                box.append(w)
        self.set_child(box)

    def mark(self, status, at=None):
        if at is None and status == "taken" and self.day != today():
            at = self.time     # a past day: the time it was due, unless you say otherwise
        self.win.change(lambda s: s.mark(self.med["id"], self.day, self.time, status, at))


class NeededRow(Gtk.ListBoxRow):
    """A medicine taken only when needed: what you took on this day, and Take now."""

    def __init__(self, win, day, med, doses):
        super().__init__(activatable=False)
        box = Gtk.Box(spacing=12, margin_top=10, margin_bottom=10, margin_start=14, margin_end=10)
        box.append(unit_icon(med["unit"]))
