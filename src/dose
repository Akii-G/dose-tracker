def read_po(path):
    """A gettext .po file -> {msgid: text, (msgid, msgid_plural): [forms]}."""
    catalog, entries, entry, key = {}, [], None, None
    with open(path, encoding="utf-8") as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith('"'):
                if entry is not None and key:
                    entry[key] += json.loads(line)
                continue
            name, _sep, rest = line.partition(" ")
            if name == "msgid":
                entry = {}
                entries.append(entry)
            if entry is not None:
                key = name
                entry[key] = json.loads(rest.strip())
    for e in entries:
        msgid = e.get("msgid")
        if not msgid:
            continue
        if "msgid_plural" in e:
            forms = [e.get("msgstr[0]", ""), e.get("msgstr[1]", "")]
            if all(forms):
                catalog[(msgid, e["msgid_plural"])] = forms
        elif e.get("msgstr"):
            catalog[msgid] = e["msgstr"]
    return catalog


