            cr.show_page()
            state["page"] += 1
            state["y"] = M

    def rule(y):
        cr.set_source_rgb(0.86, 0.86, 0.9)
        cr.set_line_width(0.7)
        cr.move_to(M, y)
        cr.line_to(W - M, y)
