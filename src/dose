        dd.set_valign(Gtk.Align.CENTER)
        dd.connect("notify::selected", lambda d, _p: set_pref("language", LANGUAGES[d.get_selected()][0]))
        row.add_suffix(dd)
        lb.append(row)
        col.append(lb)


def background_running():
    if not shutil.which("systemctl"):
        return False
    out = subprocess.run(["systemctl", "--user", "is-active", "dose-background.service"],
                         capture_output=True, text=True)
    return out.stdout.strip() == "active"


def start_background():
    """Turn on the user service from the .deb (reminders and sync) once, the first time Dose opens."""
    cfg = load_config()
    if cfg.get("service_set") or not shutil.which("systemctl"):
        return
    if not os.path.exists("/usr/lib/systemd/user/dose-background.service"):
        return
    subprocess.run(["systemctl", "--user", "enable", "--now", "dose-background.service"],
                   capture_output=True)
    cfg["service_set"] = True
    save_config(cfg)


class MainWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Dose", default_width=820, default_height=860)
        self.store = Store()
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        header = Adw.HeaderBar()
        self.stack = Adw.ViewStack(vexpand=True)
        self.today = TodayPage(self)
        self.meds = MedicinesPage(self)
        self.history = HistoryPage(self)
        self.stack.add_titled_with_icon(self.today, "today", tr("Today"), "alarm-symbolic")
        self.stack.add_titled_with_icon(self.meds, "medicines", tr("Medicines"), "view-list-symbolic")
        self.stack.add_titled_with_icon(self.history, "history", tr("History"), "x-office-calendar-symbolic")
        switcher = Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE)
        header.set_title_widget(switcher)
        add = Gtk.Button(icon_name="list-add-symbolic", tooltip_text=tr("Add a medicine"))
        add.connect("clicked", lambda *_: self.edit(None))
        header.pack_start(add)
        menu = Gio.Menu()
        menu.append(tr("Phone sync"), "win.sync")
        menu.append(tr("Preferences"), "win.prefs")
        menu.append(tr("About Dose"), "win.about")
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu))
        for name, cb in (("sync", lambda *_: SyncWindow(self).present()),
                         ("prefs", lambda *_: PrefsWindow(self).present()),
                         ("about", lambda *_: self.about())):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", cb)
            self.add_action(action)
        root.append(header)
        root.append(self.stack)
        self.set_content(root)
        self.refresh()
        GLib.timeout_add_seconds(2, self.watch)
        self.minute = dt.datetime.now().strftime("%H:%M")

    def watch(self):
        """Pick up changes from the phone or a reminder, and the clock passing a dose time."""
        now = dt.datetime.now().strftime("%H:%M")
        if self.store.changed_on_disk():
            self.store.load()
            self.refresh()
        elif now != self.minute:
            self.today.refresh()
        self.minute = now
        return True

    def refresh(self):
        self.today.refresh()
        self.meds.refresh()
        self.history.refresh()

    def change(self, fn):
        if self.store.changed_on_disk():
            self.store.load()
        fn(self.store)
        try:
            self.store.save()
        except OSError as err:
            print("Dose: could not save: %s" % err, file=sys.stderr)
        self.refresh()

    def edit(self, med_id):
        Editor(self, med_id).present()

    def about(self):
        about = Adw.AboutWindow(transient_for=self, application_name="Dose", application_icon=APP_ID,
                                version=VERSION, website="https://github.com/Akii-G/dose-tracker",
                                comments=tr("Your medicines, quietly. The sister app of Sottovoce."),
                                license_type=Gtk.License.MIT_X11) if hasattr(Adw, "AboutWindow") else None
        if about:
            about.present()


def _make_app_class():
    class _App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

        def do_activate(self):
            win = self.get_active_window()
            if not win:
                css = Gtk.CssProvider()
                try:
                    css.load_from_string(CSS)          # GTK 4.12 and newer
                except AttributeError:
                    css.load_from_data(CSS.encode())
                Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                          Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
                threading.Thread(target=start_background, daemon=True).start()
                win = MainWindow(self)
            win.present()
    return _App


