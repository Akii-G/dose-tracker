            col.append(make_label(tr("The background service isn't running, so the phone can't reach this PC. "
                                     "Install Dose from the .deb, or run: dose --background") if not (IS_WINDOWS or IS_MAC) else
                                  tr("The background part of Dose isn't running, so the phone can't reach this PC. "
                                     "Open Dose again, or reinstall it"), "dose-late", wrap=True))

    def add_copy(self, lb, title, value, sub=None):
        row = Adw.ActionRow(title=title, subtitle=GLib.markup_escape_text(value))
        if sub:
            row.set_subtitle(GLib.markup_escape_text(value + "\n" + sub))
        b = Gtk.Button(icon_name="edit-copy-symbolic", valign=Gtk.Align.CENTER, tooltip_text=tr("Copy"))
        b.add_css_class("flat")
        b.connect("clicked", lambda *_: self.get_clipboard().set(row.value))
        row.value = value
        row.add_suffix(b)
        lb.append(row)
        return row

    def on_switch(self, sw, _p):
        set_pref("sync", sw.get_active())

    def on_new(self, *_):
