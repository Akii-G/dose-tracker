        text.append(make_label(med_title(med), "heading", ellipsize=3))
        if doses:
            sub = ", ".join("%s (%s)" % (d["at"], fmt_amount(d["amount"], med["unit"])) for d in doses)
        else:
            sub = fmt_amount(med["amount"], med["unit"]) + " · " + tr("when needed")
        text.append(make_label(sub, "dim-label caption", wrap=True))
        box.append(text)
        if doses:
            undo = Gtk.Button(icon_name="edit-undo-symbolic", valign=Gtk.Align.CENTER,
                              tooltip_text=tr("Remove the last one"))
