def background_running():
    if IS_WINDOWS:
        return win_background_running()
    if IS_MAC:
        return mac_background_running()
    if not shutil.which("systemctl"):
        return False
    out = subprocess.run(["systemctl", "--user", "is-active", "dose-background.service"],
                         capture_output=True, text=True)
    return out.stdout.strip() == "active"


def start_background():
    """Turn on the user service from the .deb (reminders and sync) once, the first time Dose opens."""
    cfg = load_config()
    if IS_MAC:         # a launchd agent: at every login, kept running
        if not cfg.get("service_set"):
            if mac_background_on()[0]:
                cfg["service_set"] = True
                save_config(cfg)
        elif os.path.exists(mac_agent_path()) and (mac_agent_args() != self_command("--background")
                                                   or not mac_background_running()):
            mac_background_on()     # Dose moved (a new version in Applications), or it stopped
        return
    if IS_WINDOWS:     # at every login from the Run key, and now if it isn't running
        if not cfg.get("service_set"):
            try:
                win_set_autostart(True)
            except OSError:
                return
            cfg["service_set"] = True
            save_config(cfg)
        if win_autostart_on():
            win_start_background()
        return
    if cfg.get("service_set") or not shutil.which("systemctl"):
        return
    if not os.path.exists("/usr/lib/systemd/user/dose-background.service"):
        return
    subprocess.run(["systemctl", "--user", "enable", "--now", "dose-background.service"],
                   capture_output=True)
    cfg["service_set"] = True
    save_config(cfg)


