def tr(text):
    return CATALOG.get(text) or text


def trn(one, many, n):
    forms = CATALOG.get((one, many))
    if forms:
        return forms[0] if n == 1 else forms[1]
    return one if n == 1 else many


WEEKDAYS = [tr("Mon"), tr("Tue"), tr("Wed"), tr("Thu"), tr("Fri"), tr("Sat"), tr("Sun")]
WEEKDAYS_LONG = [tr("Monday"), tr("Tuesday"), tr("Wednesday"), tr("Thursday"), tr("Friday"),
                 tr("Saturday"), tr("Sunday")]
MONTHS = [tr("January"), tr("February"), tr("March"), tr("April"), tr("May"), tr("June"),
          tr("July"), tr("August"), tr("September"), tr("October"), tr("November"), tr("December")]


def fmt_day(day, long=False, year=False):
    """"Mon 24 Nov" / "Monday 24 November 2026", in the app's language."""
    wd = (WEEKDAYS_LONG if long else WEEKDAYS)[day.weekday()]
    month = MONTHS[day.month - 1] if long else MONTHS[day.month - 1][:3]
    if LANG_CODE == "it":
        wd, month = wd.lower(), month.lower()
    out = "%s %d %s" % (wd, day.day, month) + (" %d" % day.year if year else "")
    return out[:1].upper() + out[1:]


def fmt_date(day):
    """"24 Nov 2026"."""
    month = MONTHS[day.month - 1][:3]
    return "%d %s %d" % (day.day, month.lower() if LANG_CODE == "it" else month, day.year)


# ----------------------------------------------------------------- the model
#
# One file, dose.json: {"medicines": [...], "doses": [...], "deleted": [{"id", "stamp"}]}.
# The same fields as the iPhone app (ios/Dose/Models.swift); docs/FORMAT.md describes them.
# Every medicine and dose carries "updated" (UTC); when two devices changed the same one, the
# newer change wins. Deletions are kept as tombstones so they sync too.

UNITS = [("pill", tr("pill"), tr("pills")), ("capsule", tr("capsule"), tr("capsules")),
         ("drop", tr("drop"), tr("drops")), ("ml", tr("ml"), tr("ml")),
         ("puff", tr("puff"), tr("puffs")), ("sachet", tr("sachet"), tr("sachets")),
         ("patch", tr("patch"), tr("patches")), ("injection", tr("injection"), tr("injections")),
         ("application", tr("application"), tr("applications"))]
UNIT_KEYS = [u[0] for u in UNITS]
KINDS = [("daily", tr("Every day")), ("weekdays", tr("Some days of the week")),
         ("every", tr("Every few days")), ("needed", tr("Only when needed"))]
TIME_RE = re.compile(r"^([01]\d|2[0-3]):[0-5]\d$")


def now_stamp():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def new_id():
    return uuid.uuid4().hex[:16]


def today():
    return dt.date.today()


def parse_day(value):
    try:
        return dt.date.fromisoformat(str(value))
    except ValueError:
        return None


def clean_stamp(value):
    return value if isinstance(value, str) and re.match(r"^\d{4}-\d\d-\d\dT[\d:.]+Z$", value) else ""


def clean_amount(value):
    try:
        v = float(value)
    except (TypeError, ValueError):
        return 1.0
    return round(min(max(v, 0.25), 1000), 2)


def fmt_amount(amount, unit):
    """1 -> "1 pill", 0.5 -> "½ pill", 1.5 -> "1½ pills", 2.5 ml -> "2.5 ml"."""
    names = {u[0]: (u[1], u[2]) for u in UNITS}
    one, many = names.get(unit, (unit, unit))
    whole, frac = int(amount), round(amount - int(amount), 2)
    glyph = {0.25: "¼", 0.5: "½", 0.75: "¾"}.get(frac)
    if unit == "ml" or (frac and not glyph):
        num = ("%g" % amount).replace(".", "," if LANG_CODE == "it" else ".")
    else:
        num = (str(whole) if whole else "") + (glyph or "") if frac else str(whole)
    return "%s %s" % (num, one if amount <= 1 else many)


def clean_schedule(s):
    s = s if isinstance(s, dict) else {}
    kind = s.get("kind") if s.get("kind") in dict(KINDS) else "daily"
    times = sorted({t for t in (s.get("times") or []) if isinstance(t, str) and TIME_RE.match(t)})
    if kind != "needed" and not times:
        times = ["08:00"]
    days = sorted({int(d) for d in (s.get("weekdays") or []) if str(d).isdigit() and 1 <= int(d) <= 7})
    every = s.get("every")
    every = int(every) if isinstance(every, (int, float)) and 1 <= int(every) <= 365 else 2
    start = s.get("start") if parse_day(s.get("start")) else today().isoformat()
    end = s.get("end") if parse_day(s.get("end")) else ""
    return {"kind": kind, "times": times if kind != "needed" else [], "weekdays": days or [1, 2, 3, 4, 5, 6, 7],
            "every": every, "start": start, "end": end}


def clean_medicine(m):
    """A medicine from the file or a phone, every field checked."""
    if not isinstance(m, dict) or not str(m.get("id") or "").strip():
        return None
    text = lambda k, n=200: str(m.get(k) or "").strip()[:n]
    if not text("name"):
        return None
    stock = m.get("stock") if isinstance(m.get("stock"), dict) else None
    if stock:
        try:
            stock = {"count": round(max(float(stock.get("count")), 0), 2), "set": clean_stamp(stock.get("set")) or now_stamp()}
        except (TypeError, ValueError):
            stock = None
    refill = m.get("refillDays")
    history = [h for h in (m.get("history") or []) if isinstance(h, dict) and parse_day(h.get("date"))
               and h.get("kind") in ("started", "changed", "stopped", "restarted")][:500]
    return {"id": text("id", 64), "name": text("name"), "strength": text("strength", 60),
            "form": text("form", 80), "ingredient": text("ingredient"), "note": text("note", 500),
            "amount": clean_amount(m.get("amount")),
            "unit": m.get("unit") if m.get("unit") in UNIT_KEYS else "pill",
            "schedule": clean_schedule(m.get("schedule")), "stock": stock,
            "refillDays": int(refill) if isinstance(refill, (int, float)) and 0 <= refill <= 90 else 7,
            "archived": m.get("archived") is True, "history": history,
            "updated": clean_stamp(m.get("updated")) or now_stamp()}


def clean_dose(d):
    if not isinstance(d, dict) or not str(d.get("id") or "").strip() or not parse_day(d.get("day")):
        return None
    if d.get("status") not in ("taken", "skipped") or not str(d.get("med") or "").strip():
        return None
    t = d.get("time") if isinstance(d.get("time"), str) and TIME_RE.match(d.get("time")) else ""
    at = d.get("at") if isinstance(d.get("at"), str) and TIME_RE.match(d.get("at")) else ""
    return {"id": str(d["id"])[:120], "med": str(d["med"])[:64], "day": d["day"], "time": t,
            "status": d["status"], "at": at, "amount": clean_amount(d.get("amount")),
            "stamp": clean_stamp(d.get("stamp")) or now_stamp(),
            "updated": clean_stamp(d.get("updated")) or now_stamp()}


def slot_id(med_id, day, time_):
    return "%s@%s@%s" % (med_id, day.isoformat() if isinstance(day, dt.date) else day, time_)


def due_on(med, day):
    """Whether a scheduled medicine has doses on `day` (as-needed ones never do)."""
    s = med["schedule"]
    start, end = parse_day(s["start"]), parse_day(s["end"])
    if med["archived"] or s["kind"] == "needed" or (start and day < start) or (end and day > end):
        return False
    if s["kind"] == "weekdays":
        return day.isoweekday() in s["weekdays"]
    if s["kind"] == "every":
        return ((day - (start or day)).days % s["every"]) == 0
    return True


def per_day(med):
    """Average amount a day, for how long the stock lasts."""
    s = med["schedule"]
    n = len(s["times"]) * med["amount"]
    if s["kind"] == "weekdays":
        return n * len(s["weekdays"]) / 7
    if s["kind"] == "every":
        return n / s["every"]
    if s["kind"] == "needed":
        return 0
    return n


def schedule_text(med):
    """"Every day at 08:00 and 20:00", "Mon, Wed at 09:00", "Every 3 days at 08:00", "When needed"."""
    s = med["schedule"]
    if s["kind"] == "needed":
        out = tr("When needed")
    else:
        times = s["times"]
        at = times[0] if len(times) == 1 else tr("%s and %s") % (", ".join(times[:-1]), times[-1])
        if s["kind"] == "weekdays" and len(s["weekdays"]) < 7:
            out = tr("%s at %s") % (", ".join(WEEKDAYS[d - 1] for d in s["weekdays"]), at)
        elif s["kind"] == "every" and s["every"] > 1:
            out = tr("Every %d days at %s") % (s["every"], at)
        else:
            out = tr("Every day at %s") % at
    end = parse_day(s["end"])
    if end:
        out += " · " + tr("until %s") % fmt_date(end)
    return out


class Store:
    """dose.json: medicines, doses and tombstones."""

    def __init__(self, path=None):
        self.path = path if path is not None else os.path.join(data_dir(), "dose.json")
        self.meds, self.doses, self.deleted = {}, {}, {}
        self.mtime = None
        if self.path:
            self.load()

    # -- file

    def load(self):
        self.meds, self.doses, self.deleted = {}, {}, {}
        self.mtime = self.file_mtime()
        try:
            with open(self.path, encoding="utf-8") as f:
                doc = json.load(f)
        except (OSError, ValueError):
            return
        self.read(doc)

    def read(self, doc):
        doc = doc if isinstance(doc, dict) else {}
        for m in doc.get("medicines") or []:
            m = clean_medicine(m)
            if m:
                self.meds[m["id"]] = m
        for d in doc.get("doses") or []:
            d = clean_dose(d)
            if d:
                self.doses[d["id"]] = d
        for t in doc.get("deleted") or []:
            if isinstance(t, dict) and t.get("id") and clean_stamp(t.get("stamp")):
                self.deleted[str(t["id"])[:120]] = t["stamp"]

    def file_mtime(self):
        try:
            return os.stat(self.path).st_mtime_ns
        except OSError:
            return None

    def changed_on_disk(self):
        return bool(self.path) and self.file_mtime() != self.mtime

    def save(self):
        if not self.path:
            return
        if self.changed_on_disk():          # another process (the sync) wrote: keep both
            other = Store(self.path)
            self.absorb(other.to_json())
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.to_json(), f, ensure_ascii=False, indent=1)
        os.replace(tmp, self.path)
        self.mtime = self.file_mtime()

    def to_json(self):
        return {"medicines": sorted(self.meds.values(), key=lambda m: m["name"].lower()),
                "doses": sorted(self.doses.values(), key=lambda d: (d["day"], d["time"], d["id"])),
                "deleted": [{"id": k, "stamp": v} for k, v in sorted(self.deleted.items())]}

    def absorb(self, doc):
        """Merge another copy (the phone's): the newer change wins. Returns how many changed."""
        other = Store("")
        other.read(doc)
        changes = 0
        for key, stamp in other.deleted.items():
            if stamp > self.deleted.get(key, ""):
                self.deleted[key] = stamp
                changes += 1
        for mine, theirs in ((self.meds, other.meds), (self.doses, other.doses)):
            for key, item in theirs.items():
                if item["updated"] > mine.get(key, {}).get("updated", "") and item["updated"] > self.deleted.get(key, ""):
                    mine[key] = item
                    changes += 1
            for key in list(mine):
                if self.deleted.get(key, "") >= mine[key]["updated"]:
                    del mine[key]
                    changes += 1
        return changes

    # -- medicines

    def active(self):
        return sorted((m for m in self.meds.values() if not m["archived"]), key=lambda m: m["name"].lower())

    def archived(self):
        return sorted((m for m in self.meds.values() if m["archived"]), key=lambda m: m["name"].lower())

    @staticmethod
    def snapshot(med):
        return {"amount": med["amount"], "unit": med["unit"], "strength": med["strength"],
                "schedule": med["schedule"]}

    def put_medicine(self, med, when=None):
        """Add or change a medicine; a new one or a new dose or schedule goes in its history."""
        when = (when or today()).isoformat()
        med = clean_medicine(dict(med, updated=now_stamp()))
        old = self.meds.get(med["id"])
        if old is None:
            med["history"] = [{"date": when, "kind": "started", "detail": self.snapshot(med)}]
        else:
            med["history"] = list(old["history"])
            if self.snapshot(old) != self.snapshot(med):
                med["history"].append({"date": when, "kind": "changed", "detail": self.snapshot(med)})
        self.meds[med["id"]] = med
        self.deleted.pop(med["id"], None)
        return med

    def set_archived(self, med_id, archived, when=None):
        med = dict(self.meds[med_id])
        med["archived"] = archived
        med["history"] = list(med["history"]) + [{"date": (when or today()).isoformat(),
                                                  "kind": "stopped" if archived else "restarted",
                                                  "detail": self.snapshot(med)}]
        med["updated"] = now_stamp()
        self.meds[med_id] = med

    def delete_medicine(self, med_id):
        stamp = now_stamp()
        self.meds.pop(med_id, None)
        self.deleted[med_id] = stamp
        for key in [k for k, d in self.doses.items() if d["med"] == med_id]:
            del self.doses[key]
            self.deleted[key] = stamp

    # -- doses

    def slots(self, day):
        """[(time, med, dose or None)] scheduled on `day`, by time then name."""
        out = []
        for med in self.meds.values():
            if due_on(med, day):
                for t in med["schedule"]["times"]:
                    out.append((t, med, self.doses.get(slot_id(med["id"], day, t))))
        return sorted(out, key=lambda x: (x[0], x[1]["name"].lower()))

    def extra(self, day):
        """Doses taken when needed on `day`."""
        d = day.isoformat()
        return sorted((x for x in self.doses.values() if x["day"] == d and not x["time"]),
                      key=lambda x: x["at"])

    def mark(self, med_id, day, time_, status, at=None):
        med = self.meds[med_id]
        key = slot_id(med_id, day, time_)
        now = now_stamp()
        self.doses[key] = {"id": key, "med": med_id, "day": day.isoformat(), "time": time_,
                           "status": status, "at": at or dt.datetime.now().strftime("%H:%M"),
                           "amount": med["amount"], "stamp": now, "updated": now}
        self.deleted.pop(key, None)

    def take_now(self, med_id, day=None, at=None, amount=None):
        med = self.meds[med_id]
        key, now = new_id(), now_stamp()
        self.doses[key] = {"id": key, "med": med_id, "day": (day or today()).isoformat(), "time": "",
                           "status": "taken", "at": at or dt.datetime.now().strftime("%H:%M"),
                           "amount": clean_amount(amount or med["amount"]), "stamp": now, "updated": now}
        return key

    def unmark(self, dose_id):
        if self.doses.pop(dose_id, None) is not None:
            self.deleted[dose_id] = now_stamp()

    def day_counts(self, day):
        """(due, taken, skipped) for a day."""
        slots = self.slots(day)
        taken = sum(1 for _t, _m, d in slots if d and d["status"] == "taken")
        skipped = sum(1 for _t, _m, d in slots if d and d["status"] == "skipped")
        return len(slots), taken, skipped

    # -- stock

    def remaining(self, med):
        """How many are left, counting the doses taken since the count was set; None if not counted."""
        stock = med.get("stock")
        if not stock:
            return None
        used = sum(d["amount"] for d in self.doses.values()
                   if d["med"] == med["id"] and d["status"] == "taken" and d["stamp"] > stock["set"])
        return max(stock["count"] - used, 0)

    def days_left(self, med):
        left, rate = self.remaining(med), per_day(med)
        if left is None or not rate:
            return None
        return int(left / rate)

    def low(self, med):
        days = self.days_left(med)
        return days is not None and days <= med["refillDays"]


# ----------------------------------------------------------------- medicine search
# data/medicines-it.tsv, built from AIFA's open data by tools/build_medicines.py:
# name, strength, form, active ingredient. Searched here, on the device: nothing is looked
# up online, so no one learns what you take.

_MEDICINES = None


def fold(text):
    """Lower case without accents: "Perché" -> "perche"."""
    return "".join(c for c in unicodedata.normalize("NFD", text.lower()) if unicodedata.category(c) != "Mn")


def medicines():
    global _MEDICINES
    if _MEDICINES is None:
        _MEDICINES = []
        for path in share_paths(os.path.join("data", "medicines-it.tsv")) + share_paths("medicines-it.tsv"):
            if os.path.exists(path):
                with open(path, encoding="utf-8") as f:
                    for line in f:
                        if line.startswith("#"):
                            continue
                        parts = line.rstrip("\n").split("\t")
                        if len(parts) == 4:
                            _MEDICINES.append(tuple(parts) + (fold(parts[0]), fold(parts[3])))
                break
    return _MEDICINES


def search_medicines(query, limit=40):
    """Names starting with the words first, then ingredients, then names containing them."""
    q = fold(query.strip())
    if len(q) < 2:
        return []
    first, second, third = [], [], []
    for name, strength, form, ingredient, fname, fingredient in medicines():
        if fname.startswith(q):
            first.append((name, strength, form, ingredient))
        elif fingredient.startswith(q):
            second.append((name, strength, form, ingredient))
        elif q in fname or q in fingredient:
            third.append((name, strength, form, ingredient))
        if len(first) >= limit:
            break
    return (first + second + third)[:limit]


# ----------------------------------------------------------------- encrypted sync
#
# The same scheme as Sottovoce: AES-256-GCM with a key derived from the shared token
# (HKDF-SHA256), so the token never crosses the network. A message is JSON {"v": 1, "n":
# base64 nonce, "c": base64 ciphertext+tag}; the additional data binds it to its endpoint
# and direction. ios/Dose/SyncCrypto.swift must match; ios/CryptoCheck checks both.

SYNC_SALT, SYNC_INFO = b"dose-sync", b"dose sync v1"


def sync_key(token):
    from cryptography.hazmat.primitives import hashes
    from cryptography.hazmat.primitives.kdf.hkdf import HKDF
    return HKDF(algorithm=hashes.SHA256(), length=32, salt=SYNC_SALT, info=SYNC_INFO).derive(token.encode("utf-8"))


def sync_aad(path, reply):
    return ("dose/v1 %s %s" % ("reply" if reply else "request", path)).encode("utf-8")


def seal(token, path, obj, reply=False, nonce=None):
    import base64
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    nonce = nonce or secrets.token_bytes(12)
    data = AESGCM(sync_key(token)).encrypt(nonce, json.dumps(obj, ensure_ascii=False).encode("utf-8"),
                                           sync_aad(path, reply))
    return json.dumps({"v": 1, "n": base64.b64encode(nonce).decode(), "c": base64.b64encode(data).decode()}).encode()


def unseal(token, path, body, reply=False):
    import base64, binascii
    from cryptography.exceptions import InvalidTag
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    try:
        doc = json.loads(body)
        nonce, data = base64.b64decode(doc["n"]), base64.b64decode(doc["c"])
        if doc.get("v") != 1 or len(nonce) != 12:
            raise ValueError("unknown format")
        return json.loads(AESGCM(sync_key(token)).decrypt(nonce, data, sync_aad(path, reply)))
    except (KeyError, TypeError, binascii.Error, InvalidTag, UnicodeDecodeError, ValueError, AttributeError) as err:
        raise ValueError("not readable with this token") from err


def crypto_available():
    try:
        import cryptography.hazmat.primitives.ciphers.aead  # noqa: F401
        return True
    except ImportError:
        return False


def sync_config():
    """Token and port for the phone sync (created on first use, readable only by you)."""
    path = os.path.join(data_dir(), "sync.json")
    try:
        with open(path, encoding="utf-8") as f:
            cfg = json.load(f)
        if isinstance(cfg.get("token"), str) and len(cfg["token"]) >= 16:
            cfg.setdefault("port", SYNC_PORT)
            return cfg
    except (OSError, ValueError, AttributeError):
        pass
    return new_sync_token(port=SYNC_PORT)


def new_sync_token(port=None):
    path = os.path.join(data_dir(), "sync.json")
    cfg = {"token": secrets.token_urlsafe(18), "port": port or sync_config().get("port", SYNC_PORT)}
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(cfg, f)
    os.replace(path + ".tmp", path)
    return cfg


def lan_address():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("192.0.2.1", 9))   # no packet is sent; it only picks the LAN interface
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return None


def sync_status_path():
    return os.path.join(data_dir(), "sync-last.txt")


def sync_with_phone(doc):
    """Merge what the phone sent into dose.json and return the merged state."""
    store = Store()
    changed = store.absorb(doc if isinstance(doc, dict) else {})
    if changed:
        store.save()
    state = store.to_json()
    state["changed"] = changed
    return state


def make_server(port):
    import http.server

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "Dose/" + VERSION

        def send(self, code, body, kind="application/json"):
            self.send_response(code)
            self.send_header("Content-Type", kind)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def error(self, code, message):
            self.send(code, json.dumps({"error": message}).encode("utf-8"))

        def do_GET(self):
            self.send(200, b"Dose sync is running.\n", "text/plain")

        def do_POST(self):
            route = self.path.split("?", 1)[0].rstrip("/")
            if not prefs()["sync"]:
                self.error(403, tr("Phone sync is switched off in Dose on your PC."))
                return
            if not crypto_available():
                self.error(501, tr("Sync needs the python3-cryptography package on the PC."))
                return
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                length = 0
            if not 0 < length <= 30 * 1024 * 1024:
                self.error(400, tr("Empty request, or too large."))
                return
            token = sync_config()["token"]
            try:
                doc = unseal(token, route, self.rfile.read(length))
            except ValueError:
                self.error(401, tr("The token doesn't match. Copy it again from Dose on your PC."))
                return
            if route == "/api/e/ping":
                answer = {"app": "Dose", "version": VERSION}
            elif route == "/api/e/sync":
                answer = sync_with_phone(doc)
                device = str(doc.get("device") or "") if isinstance(doc, dict) else ""
                try:
                    with open(sync_status_path(), "w", encoding="utf-8") as f:
                        f.write("%s\n%s\n%d\n" % (dt.datetime.now().strftime("%Y-%m-%d %H:%M"), device[:60],
                                                  answer["changed"]))
                except OSError:
                    pass
            else:
                self.error(404, "unknown")
                return
            self.send(200, seal(token, route, answer, reply=True))

        def log_message(self, fmt, *args):
            sys.stderr.write("dose-sync: %s\n" % (fmt % args))

    server = http.server.ThreadingHTTPServer(("0.0.0.0", port), Handler)
    server.daemon_threads = True
    return server


# ----------------------------------------------------------------- reminders on this PC
#
# `dose --background` (the dose-background user service) checks every 30 seconds for doses
# that are due and not marked yet, and shows a notification with Taken and Later buttons
# (notify-send). One reminder at the time, and one more 30 minutes later if follow-ups are on.

def notified_path():
    return os.path.join(data_dir(), "notified.json")


def due_now(store, now, follow_up, snoozed):
    """[(key, time, [meds], again)] reminders to show at `now`, grouped by time."""
    day = now.date()
    groups = {}
    for t, med, dose in store.slots(day):
        if dose:
            continue
        at = dt.datetime.combine(day, dt.time(int(t[:2]), int(t[3:])))
        if now < at or now - at > dt.timedelta(hours=3):
            continue
        groups.setdefault(t, []).append(med)
    out = []
    for t, meds in sorted(groups.items()):
        at = dt.datetime.combine(day, dt.time(int(t[:2]), int(t[3:])))
        key = "%s %s" % (day.isoformat(), t)
        state = snoozed.get(key)
        if state is None:
            out.append((key, t, meds, False))
        elif state.get("until") and now.timestamp() >= state["until"]:
            out.append((key, t, meds, True))
        elif follow_up and not state.get("again") and now - at >= dt.timedelta(minutes=30) \
                and not state.get("until"):
            out.append((key, t, meds, True))
    return out


def reminder_text(t, meds, discreet):
    if discreet:
        return tr("Dose"), tr("Time for your %s dose") % t
    names = ", ".join(m["name"] + (" " + m["strength"] if m["strength"] else "") for m in meds)
    amounts = ""
    if len(meds) == 1:
        amounts = " · " + fmt_amount(meds[0]["amount"], meds[0]["unit"])
    return tr("%s · time for your medicine") % t, names + amounts


def notify(title, body, actions):
    """notify-send with buttons; returns the chosen action or None. Blocks until answered."""
    exe = shutil.which("notify-send")
    if not exe:
        return None
    args = [exe, "-a", "Dose", "-i", APP_ID, "-u", "normal"]
    for key, label in actions:
        args += ["-A", "%s=%s" % (key, label)]
    try:
        out = subprocess.run(args + [title, body], capture_output=True, text=True, timeout=6 * 3600)
        if out.returncode != 0 and actions:     # an older notify-send without buttons
            subprocess.run([exe, "-a", "Dose", "-i", APP_ID, title, body], timeout=30)
            return None
        return out.stdout.strip() or None
    except (OSError, subprocess.SubprocessError):
        return None


def run_background():
    """Reminders, and the phone sync while it's switched on. Runs until stopped."""
    server, server_thread = None, None
    try:
        with open(notified_path(), encoding="utf-8") as f:
            seen = json.load(f)
    except (OSError, ValueError):
        seen = {}
    lock = threading.Lock()

    def answer(key, day, t, meds):
        p = prefs()
        title, body = reminder_text(t, meds, p["discreet"])
        choice = notify(title, body, [("taken", tr("Taken")), ("later", tr("Later"))])
        with lock:
            if choice == "taken":
                store = Store()
                for m in meds:
                    if not store.doses.get(slot_id(m["id"], day, t)):
                        store.mark(m["id"], day, t, "taken")
                store.save()
            elif choice == "later":
                seen[key] = {"until": time.time() + 10 * 60, "again": False}
                save_seen()

    def save_seen():
        try:
            cut = (today() - dt.timedelta(days=2)).isoformat()
            for k in [k for k in seen if k < cut]:
                del seen[k]
            with open(notified_path(), "w", encoding="utf-8") as f:
                json.dump(seen, f)
        except OSError:
            pass

    while True:
        p = prefs()
        if p["sync"] and server is None and crypto_available():
            try:
                server = make_server(int(sync_config().get("port", SYNC_PORT)))
                server_thread = threading.Thread(target=server.serve_forever, daemon=True)
                server_thread.start()
                print("Dose sync listening on port %d" % server.server_address[1], flush=True)
            except OSError as err:
                print("Dose sync can't start: %s" % err, flush=True)
                server = None
        elif not p["sync"] and server is not None:
            server.shutdown()
            server.server_close()
            server = None
        if p["remind"]:
            now = dt.datetime.now()
            store = Store()
            with lock:
                todo = due_now(store, now, p["follow_up"], seen)
                for key, t, meds, again in todo:
                    seen[key] = {"until": 0, "again": again}
                if todo:
                    save_seen()
            for key, t, meds, again in todo:
                threading.Thread(target=answer, args=(key, now.date(), t, meds), daemon=True).start()
        time.sleep(30)


