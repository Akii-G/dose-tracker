            box.append(undo)
        take = Gtk.Button(label=tr("Take now") if day == today() else tr("Add"), valign=Gtk.Align.CENTER)
        take.connect("clicked", lambda *_: win.change(
            lambda s: s.take_now(med["id"], day=day, at=None if day == today() else "12:00")))
        box.append(take)
        self.set_child(box)


def day_list(win, day, store):
    """The rows of one day, grouped by part of the day, then the as-needed ones."""
    col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    slots = store.slots(day)
    times = {}
    for t, med, dose in slots:
        times.setdefault(t, []).append((t, med, dose))
    for t in sorted(times):
        col.append(make_label(t, "dose-part dose-time-head"))
        lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        lb.add_css_class("boxed-list")
        for t, med, dose in times[t]:
            lb.append(DoseRow(win, day, t, med, dose))
        col.append(lb)
    needed = [m for m in store.active() if m["schedule"]["kind"] == "needed"]
    extra = store.extra(day)
    if needed or extra:
        col.append(make_label(tr("When needed"), "dose-part"))
        lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        lb.add_css_class("boxed-list")
        ids = [m["id"] for m in needed] + [d["med"] for d in extra if d["med"] not in [m["id"] for m in needed]]
        for mid in ids:
            if mid in store.meds:
                lb.append(NeededRow(win, day, store.meds[mid], [d for d in extra if d["med"] == mid]))
        col.append(lb)
    return col, bool(slots or needed or extra)


class TodayPage(Gtk.ScrolledWindow):
    def __init__(self, win):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.win = win
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=18, margin_bottom=24,
                           margin_start=18, margin_end=18)
        clamp = Adw.Clamp(maximum_size=720)
        clamp.set_child(self.box)
        self.set_child(clamp)

    def refresh(self):
        clear(self.box)
        store, day = self.win.store, today()
        if not store.meds:
            page = Adw.StatusPage(icon_name=APP_ID, title=tr("No medicines yet"),
                                  description=tr("Add the medicines you take, and Dose will remind you "
                                                 "when it's time and remember what you took."))
            icon = app_icon_texture()
            if icon:
                page.set_paintable(icon)
            add = Gtk.Button(label=tr("Add a medicine"), halign=Gtk.Align.CENTER)
            add.add_css_class("suggested-action")
            add.add_css_class("pill")
            add.connect("clicked", lambda *_: self.win.edit(None))
            page.set_child(add)
            self.box.append(page)
            return
        self.box.append(make_label(fmt_day(day, long=True), "dose-big"))
        due, taken, skipped = store.day_counts(day)
        if due:
            line = tr("%d of %d taken") % (taken, due) if taken < due else tr("All taken today")
            if skipped:
                line += " · " + trn("%d skipped", "%d skipped", skipped) % skipped
        else:
            line = tr("Nothing scheduled today")
        self.box.append(make_label(line, "dim-label"))
        low = [m for m in store.active() if store.low(m)]
        if low:
            text = tr("Running low: %s") % ", ".join(
                "%s (%s)" % (m["name"], trn("%d day left", "%d days left", store.days_left(m)) % store.days_left(m))
                for m in low)
            self.box.append(make_label(text, "dose-low", wrap=True, margin_top=10))
        col, _any = day_list(self.win, day, store)
        self.box.append(col)


class MedicinesPage(Gtk.ScrolledWindow):
    def __init__(self, win):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.win = win
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=18, margin_bottom=24,
                           margin_start=18, margin_end=18)
        clamp = Adw.Clamp(maximum_size=720)
        clamp.set_child(self.box)
        self.set_child(clamp)

    def row(self, med):
        row = Adw.ActionRow(title=GLib.markup_escape_text(med_title(med)), activatable=True)
        row.add_prefix(unit_icon(med["unit"]))
        sub = schedule_text(med) if med["schedule"].get("amounts") else \
            "%s · %s" % (fmt_amount(med["amount"], med["unit"]), schedule_text(med))
        if med["form"]:
            sub = med["form"] + " · " + sub
        row.set_subtitle(GLib.markup_escape_text(sub))
        left = self.win.store.remaining(med)
        if left is not None:
            days = self.win.store.days_left(med)
            text = tr("%s left") % ("%g" % left) + ("" if days is None else " · " + trn("%d day", "%d days", days) % days)
            lab = make_label(text, "dose-late" if self.win.store.low(med) else "dim-label")
            row.add_suffix(lab)
        row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        row.connect("activated", lambda *_: self.win.edit(med["id"]))
        return row

    def refresh(self):
        clear(self.box)
        store = self.win.store
        active, stopped = store.active(), store.archived()
        head = Gtk.Box(spacing=8)
        head.append(make_label(tr("Your medicines"), "dose-big", hexpand=True))
        add = Gtk.Button(label=tr("Add a medicine"), valign=Gtk.Align.CENTER)
        add.add_css_class("suggested-action")
        add.connect("clicked", lambda *_: self.win.edit(None))
        head.append(add)
        self.box.append(head)
        if not active:
            self.box.append(make_label(tr("No medicines yet."), "dim-label", margin_top=12))
        else:
            lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, margin_top=12)
            lb.add_css_class("boxed-list")
            for med in active:
                lb.append(self.row(med))
            self.box.append(lb)
        if stopped:
            self.box.append(make_label(tr("No longer taken"), "dose-part"))
            lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            lb.add_css_class("boxed-list")
            for med in stopped:
                lb.append(self.row(med))
            self.box.append(lb)
        self.box.append(make_label(tr("Medicine names: AIFA open data (CC BY 4.0). Dose doesn't give "
                                      "medical advice: follow what your doctor prescribed."),
                                   "dim-label caption", wrap=True, margin_top=18))


