WEEKDAYS = [tr("Mon"), tr("Tue"), tr("Wed"), tr("Thu"), tr("Fri"), tr("Sat"), tr("Sun")]
WEEKDAYS_LONG = [tr("Monday"), tr("Tuesday"), tr("Wednesday"), tr("Thursday"), tr("Friday"),
                 tr("Saturday"), tr("Sunday")]
MONTHS = [tr("January"), tr("February"), tr("March"), tr("April"), tr("May"), tr("June"),
          tr("July"), tr("August"), tr("September"), tr("October"), tr("November"), tr("December")]


def fmt_day(day, long=False, year=False):
    """"Mon 24 Nov" / "Monday 24 November 2026", in the app's language."""
    wd = (WEEKDAYS_LONG if long else WEEKDAYS)[day.weekday()]
    month = MONTHS[day.month - 1] if long else MONTHS[day.month - 1][:3]
    if LANG_CODE == "it":
        wd, month = wd.lower(), month.lower()
    out = "%s %d %s" % (wd, day.day, month) + (" %d" % day.year if year else "")
    return out[:1].upper() + out[1:]


def fmt_date(day):
    """"24 Nov 2026"."""
    month = MONTHS[day.month - 1][:3]
    return "%d %s %d" % (day.day, month.lower() if LANG_CODE == "it" else month, day.year)


# ----------------------------------------------------------------- the model
#
# One file, dose.json: {"medicines": [...], "doses": [...], "deleted": [{"id", "stamp"}]}.
# The same fields as the iPhone app (ios/Dose/Models.swift); docs/FORMAT.md describes them.
# Every medicine and dose carries "updated" (UTC); when two devices changed the same one, the
# newer change wins. Deletions are kept as tombstones so they sync too.

UNITS = [("pill", tr("pill"), tr("pills")), ("capsule", tr("capsule"), tr("capsules")),
         ("drop", tr("drop"), tr("drops")), ("ml", tr("ml"), tr("ml")),
         ("puff", tr("puff"), tr("puffs")), ("sachet", tr("sachet"), tr("sachets")),
         ("patch", tr("patch"), tr("patches")), ("injection", tr("injection"), tr("injections")),
         ("application", tr("application"), tr("applications"))]
UNIT_KEYS = [u[0] for u in UNITS]
KINDS = [("daily", tr("Every day")), ("weekdays", tr("Some days of the week")),
         ("every", tr("Every few days")), ("needed", tr("Only when needed"))]
TIME_RE = re.compile(r"^([01]\d|2[0-3]):[0-5]\d$")


def now_stamp():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def new_id():
    return uuid.uuid4().hex[:16]


def today():
    return dt.date.today()


def parse_day(value):
    try:
        return dt.date.fromisoformat(str(value))
    except ValueError:
        return None


def clean_stamp(value):
    return value if isinstance(value, str) and re.match(r"^\d{4}-\d\d-\d\dT[\d:.]+Z$", value) else ""


def clean_amount(value):
    try:
        v = float(value)
    except (TypeError, ValueError):
        return 1.0
    return round(min(max(v, 0.25), 1000), 2)


def fmt_amount(amount, unit):
    """1 -> "1 pill", 0.5 -> "½ pill", 1.5 -> "1½ pills", 2.5 ml -> "2.5 ml"."""
    names = {u[0]: (u[1], u[2]) for u in UNITS}
    one, many = names.get(unit, (unit, unit))
    whole, frac = int(amount), round(amount - int(amount), 2)
    glyph = {0.25: "¼", 0.5: "½", 0.75: "¾"}.get(frac)
    if unit == "ml" or (frac and not glyph):
        num = ("%g" % amount).replace(".", "," if LANG_CODE == "it" else ".")
    else:
        num = (str(whole) if whole else "") + (glyph or "") if frac else str(whole)
    return "%s %s" % (num, one if amount <= 1 else many)


def clean_schedule(s):
    s = s if isinstance(s, dict) else {}
    kind = s.get("kind") if s.get("kind") in dict(KINDS) else "daily"
    times = sorted({t for t in (s.get("times") or []) if isinstance(t, str) and TIME_RE.match(t)})
    if kind != "needed" and not times:
        times = ["08:00"]
    days = sorted({int(d) for d in (s.get("weekdays") or []) if str(d).isdigit() and 1 <= int(d) <= 7})
    every = s.get("every")
    every = int(every) if isinstance(every, (int, float)) and 1 <= int(every) <= 365 else 2
    start = s.get("start") if parse_day(s.get("start")) else today().isoformat()
    end = s.get("end") if parse_day(s.get("end")) else ""
    times = times if kind != "needed" else []
    out = {"kind": kind, "times": times, "weekdays": days or [1, 2, 3, 4, 5, 6, 7],
           "every": every, "start": start, "end": end}
    # a different amount at some times ("08:00": 1, "20:00": 0.5); left out when not used
    amounts = {}
    for t, a in (s.get("amounts") if isinstance(s.get("amounts"), dict) else {}).items():
        if t in times and isinstance(a, (int, float)) and not isinstance(a, bool) and 0 < a <= 1000:
            amounts[t] = clean_amount(a)
    if amounts:
        out["amounts"] = amounts
    return out


def amount_at(med, t):
    """How much is taken at time `t`: its own amount if it has one, else the medicine's."""
    return med["schedule"].get("amounts", {}).get(t, med["amount"])


def clean_medicine(m):
    """A medicine from the file or a phone, every field checked."""
    if not isinstance(m, dict) or not str(m.get("id") or "").strip():
        return None
    text = lambda k, n=200: str(m.get(k) or "").strip()[:n]
    if not text("name"):
        return None
    stock = m.get("stock") if isinstance(m.get("stock"), dict) else None
    if stock:
        try:
            stock = {"count": round(max(float(stock.get("count")), 0), 2), "set": clean_stamp(stock.get("set")) or now_stamp()}
        except (TypeError, ValueError):
            stock = None
    refill = m.get("refillDays")
    history = [h for h in (m.get("history") or []) if isinstance(h, dict) and parse_day(h.get("date"))
               and h.get("kind") in ("started", "changed", "stopped", "restarted")][:500]
    return {"id": text("id", 64), "name": text("name"), "strength": text("strength", 60),
            "form": text("form", 80), "ingredient": text("ingredient"), "note": text("note", 500),
            "amount": clean_amount(m.get("amount")),
            "unit": m.get("unit") if m.get("unit") in UNIT_KEYS else "pill",
            "schedule": clean_schedule(m.get("schedule")), "stock": stock,
            "refillDays": int(refill) if isinstance(refill, (int, float)) and 0 <= refill <= 90 else 7,
            "archived": m.get("archived") is True, "history": history,
            "updated": clean_stamp(m.get("updated")) or now_stamp()}


def clean_dose(d):
    if not isinstance(d, dict) or not str(d.get("id") or "").strip() or not parse_day(d.get("day")):
        return None
    if d.get("status") not in ("taken", "skipped") or not str(d.get("med") or "").strip():
        return None
    t = d.get("time") if isinstance(d.get("time"), str) and TIME_RE.match(d.get("time")) else ""
    at = d.get("at") if isinstance(d.get("at"), str) and TIME_RE.match(d.get("at")) else ""
    return {"id": str(d["id"])[:120], "med": str(d["med"])[:64], "day": d["day"], "time": t,
            "status": d["status"], "at": at, "amount": clean_amount(d.get("amount")),
            "stamp": clean_stamp(d.get("stamp")) or now_stamp(),
            "updated": clean_stamp(d.get("updated")) or now_stamp()}


def slot_id(med_id, day, time_):
    return "%s@%s@%s" % (med_id, day.isoformat() if isinstance(day, dt.date) else day, time_)


def due_on(med, day):
    """Whether a scheduled medicine has doses on `day` (as-needed ones never do)."""
    s = med["schedule"]
    start, end = parse_day(s["start"]), parse_day(s["end"])
    if med["archived"] or s["kind"] == "needed" or (start and day < start) or (end and day > end):
        return False
    if s["kind"] == "weekdays":
        return day.isoweekday() in s["weekdays"]
    if s["kind"] == "every":
        return ((day - (start or day)).days % s["every"]) == 0
    return True


def per_day(med):
    """Average amount a day, for how long the stock lasts."""
    s = med["schedule"]
    n = sum(amount_at(med, t) for t in s["times"])
    if s["kind"] == "weekdays":
        return n * len(s["weekdays"]) / 7
    if s["kind"] == "every":
        return n / s["every"]
    if s["kind"] == "needed":
        return 0
    return n


def schedule_text(med):
    """"Every day at 08:00 and 20:00", "Mon, Wed at 09:00", "Every 3 days at 08:00", "When needed"."""
    s = med["schedule"]
    if s["kind"] == "needed":
        out = tr("When needed")
    else:
        times = s["times"]
        if s.get("amounts"):      # "08:00 (1 pill) and 20:00 (½ pill)"
            times = ["%s (%s)" % (t, fmt_amount(amount_at(med, t), med["unit"])) for t in times]
        at = times[0] if len(times) == 1 else tr("%s and %s") % (", ".join(times[:-1]), times[-1])
        if s["kind"] == "weekdays" and len(s["weekdays"]) < 7:
            out = tr("%s at %s") % (", ".join(WEEKDAYS[d - 1] for d in s["weekdays"]), at)
        elif s["kind"] == "every" and s["every"] > 1:
            out = tr("Every %d days at %s") % (s["every"], at)
        else:
            out = tr("Every day at %s") % at
    end = parse_day(s["end"])
    if end:
        out += " · " + tr("until %s") % fmt_date(end)
    return out


class Store:
    """dose.json: medicines, doses and tombstones."""

    def __init__(self, path=None):
        self.path = path if path is not None else os.path.join(data_dir(), "dose.json")
        self.meds, self.doses, self.deleted = {}, {}, {}
        self.mtime = None
        if self.path:
            self.load()

    # -- file

    def load(self):
        self.meds, self.doses, self.deleted = {}, {}, {}
        self.mtime = self.file_mtime()
        try:
            with open(self.path, encoding="utf-8") as f:
                doc = json.load(f)
        except (OSError, ValueError):
            return
        self.read(doc)

    def read(self, doc):
        doc = doc if isinstance(doc, dict) else {}
        for m in doc.get("medicines") or []:
            m = clean_medicine(m)
            if m:
                self.meds[m["id"]] = m
        for d in doc.get("doses") or []:
            d = clean_dose(d)
            if d:
                self.doses[d["id"]] = d
        for t in doc.get("deleted") or []:
            if isinstance(t, dict) and t.get("id") and clean_stamp(t.get("stamp")):
                self.deleted[str(t["id"])[:120]] = t["stamp"]

    def file_mtime(self):
        try:
            return os.stat(self.path).st_mtime_ns
        except OSError:
            return None

    def changed_on_disk(self):
        return bool(self.path) and self.file_mtime() != self.mtime

    def save(self):
        if not self.path:
            return
        if self.changed_on_disk():          # another process (the sync) wrote: keep both
            other = Store(self.path)
            self.absorb(other.to_json())
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.to_json(), f, ensure_ascii=False, indent=1)
        os.replace(tmp, self.path)
        self.mtime = self.file_mtime()

    def to_json(self):
        return {"medicines": sorted(self.meds.values(), key=lambda m: m["name"].lower()),
                "doses": sorted(self.doses.values(), key=lambda d: (d["day"], d["time"], d["id"])),
                "deleted": [{"id": k, "stamp": v} for k, v in sorted(self.deleted.items())]}

    def absorb(self, doc):
        """Merge another copy (the phone's): the newer change wins. Returns how many changed."""
        other = Store("")
        other.read(doc)
        changes = 0
        for key, stamp in other.deleted.items():
            if stamp > self.deleted.get(key, ""):
                self.deleted[key] = stamp
                changes += 1
        for mine, theirs in ((self.meds, other.meds), (self.doses, other.doses)):
            for key, item in theirs.items():
                if item["updated"] > mine.get(key, {}).get("updated", "") and item["updated"] > self.deleted.get(key, ""):
                    mine[key] = item
                    changes += 1
            for key in list(mine):
                if self.deleted.get(key, "") >= mine[key]["updated"]:
                    del mine[key]
                    changes += 1
        return changes

    # -- medicines

    def active(self):
        return sorted((m for m in self.meds.values() if not m["archived"]), key=lambda m: m["name"].lower())

    def archived(self):
        return sorted((m for m in self.meds.values() if m["archived"]), key=lambda m: m["name"].lower())

    @staticmethod
    def snapshot(med):
        return {"amount": med["amount"], "unit": med["unit"], "strength": med["strength"],
                "schedule": med["schedule"]}

    def put_medicine(self, med, when=None):
        """Add or change a medicine; a new one or a new dose or schedule goes in its history."""
        when = (when or today()).isoformat()
        med = clean_medicine(dict(med, updated=now_stamp()))
        old = self.meds.get(med["id"])
        if old is None:
            med["history"] = [{"date": when, "kind": "started", "detail": self.snapshot(med)}]
        else:
            med["history"] = list(old["history"])
            if self.snapshot(old) != self.snapshot(med):
                med["history"].append({"date": when, "kind": "changed", "detail": self.snapshot(med)})
        self.meds[med["id"]] = med
        self.deleted.pop(med["id"], None)
        return med

    def set_archived(self, med_id, archived, when=None):
        med = dict(self.meds[med_id])
        med["archived"] = archived
        med["history"] = list(med["history"]) + [{"date": (when or today()).isoformat(),
                                                  "kind": "stopped" if archived else "restarted",
                                                  "detail": self.snapshot(med)}]
        med["updated"] = now_stamp()
        self.meds[med_id] = med

    def delete_medicine(self, med_id):
        stamp = now_stamp()
        self.meds.pop(med_id, None)
        self.deleted[med_id] = stamp
        for key in [k for k, d in self.doses.items() if d["med"] == med_id]:
            del self.doses[key]
            self.deleted[key] = stamp

    # -- doses

    def slots(self, day):
        """[(time, med, dose or None)] scheduled on `day`, by time then name."""
        out = []
        for med in self.meds.values():
            if due_on(med, day):
                for t in med["schedule"]["times"]:
                    out.append((t, med, self.doses.get(slot_id(med["id"], day, t))))
        return sorted(out, key=lambda x: (x[0], x[1]["name"].lower()))

    def extra(self, day):
        """Doses taken when needed on `day`."""
        d = day.isoformat()
        return sorted((x for x in self.doses.values() if x["day"] == d and not x["time"]),
                      key=lambda x: x["at"])

    def mark(self, med_id, day, time_, status, at=None):
        med = self.meds[med_id]
        key = slot_id(med_id, day, time_)
        now = now_stamp()
        self.doses[key] = {"id": key, "med": med_id, "day": day.isoformat(), "time": time_,
                           "status": status, "at": at or dt.datetime.now().strftime("%H:%M"),
                           "amount": amount_at(med, time_), "stamp": now, "updated": now}
        self.deleted.pop(key, None)

    def take_now(self, med_id, day=None, at=None, amount=None):
        med = self.meds[med_id]
        key, now = new_id(), now_stamp()
        self.doses[key] = {"id": key, "med": med_id, "day": (day or today()).isoformat(), "time": "",
                           "status": "taken", "at": at or dt.datetime.now().strftime("%H:%M"),
                           "amount": clean_amount(amount or med["amount"]), "stamp": now, "updated": now}
        return key

    def unmark(self, dose_id):
        if self.doses.pop(dose_id, None) is not None:
            self.deleted[dose_id] = now_stamp()

    def day_counts(self, day):
        """(due, taken, skipped) for a day."""
        slots = self.slots(day)
        taken = sum(1 for _t, _m, d in slots if d and d["status"] == "taken")
        skipped = sum(1 for _t, _m, d in slots if d and d["status"] == "skipped")
        return len(slots), taken, skipped

    # -- stock

    def remaining(self, med):
        """How many are left, counting the doses taken since the count was set; None if not counted."""
        stock = med.get("stock")
        if not stock:
            return None
        used = sum(d["amount"] for d in self.doses.values()
                   if d["med"] == med["id"] and d["status"] == "taken" and d["stamp"] > stock["set"])
        return max(stock["count"] - used, 0)

    def days_left(self, med):
        left, rate = self.remaining(med), per_day(med)
        if left is None or not rate:
            return None
        return int(left / rate)

    def low(self, med):
        days = self.days_left(med)
        return days is not None and days <= med["refillDays"]


# ----------------------------------------------------------------- medicine search
# data/medicines-it.tsv, built from AIFA's open data by tools/build_medicines.py:
# name, strength, form, active ingredient, and the AIC codes of its packs ("012345:045,057").
# Searched here, on the device: nothing is looked up online, so no one learns what you take.

_MEDICINES = None


def fold(text):
    """Lower case without accents: "Perché" -> "perche"."""
    return "".join(c for c in unicodedata.normalize("NFD", text.lower()) if unicodedata.category(c) != "Mn")


def medicines():
    global _MEDICINES
    if _MEDICINES is None:
        _MEDICINES = []
        for path in share_paths(os.path.join("data", "medicines-it.tsv")) + share_paths("medicines-it.tsv"):
            if os.path.exists(path):
                with open(path, encoding="utf-8") as f:
                    for line in f:
                        if line.startswith("#"):
                            continue
                        parts = line.rstrip("\n").split("\t")
                        if len(parts) >= 4:
                            _MEDICINES.append(tuple(parts[:4]) + (fold(parts[0]), fold(parts[3]),
                                                                  parts[4] if len(parts) > 4 else ""))
                break
    return _MEDICINES


def search_medicines(query, limit=40):
    """Names starting with the words first, then ingredients, then names containing them."""
    code = aic_from_text(query)
    if code:                       # an AIC number from the box, typed: the medicine of that pack
        found = find_aic(code)
        return [found] if found else []
    q = fold(query.strip())
    if len(q) < 2:
        return []
    first, second, third = [], [], []
    for name, strength, form, ingredient, fname, fingredient, _packs in medicines():
        if fname.startswith(q):
            first.append((name, strength, form, ingredient))
        elif fingredient.startswith(q):
            second.append((name, strength, form, ingredient))
        elif q in fname or q in fingredient:
            third.append((name, strength, form, ingredient))
        if len(first) >= limit:
            break
    return (first + second + third)[:limit]


# ----------------------------------------------------------------- report
#
# For the doctor: for a period, each medicine's doses taken, skipped and not taken, those taken
# when needed, and the changes; then the doses day by day. As a PDF, and as a CSV for a spreadsheet.
# The phones make the same report (ios/Dose/Report.swift, android …/Report.kt).

def stopped_on(med):
    """The day a stopped medicine was stopped (its last "stopped" change), or None."""
    days = [parse_day(h["date"]) for h in med["history"] if h["kind"] == "stopped"]
    return max(days) if med["archived"] and days else None


def was_due(med, day):
    """Like due_on, but a medicine stopped later still counts on the days before it was stopped."""
    stop = stopped_on(med)
    if med["archived"] and stop and day < stop:
        med = dict(med, archived=False)
    return due_on(med, day)


def report_data(store, start, end, now=None):
    """{"meds": [{med, due, taken, skipped, missed}], "needed": [{med, count}], "days": [(day, [rows])],
    "changes": [(day, med, kind, text)]} for start..end (both included). Doses due after `now` aren't
    counted yet; a past dose not marked is "not taken"."""
    now = now or dt.datetime.now()
    meds, needed, days = {}, {}, []
    day = start
    while day <= end:
        rows = []
        for med in store.meds.values():
            if not was_due(med, day):
                continue
            for t in med["schedule"]["times"]:
                at = dt.datetime.combine(day, dt.time(*map(int, t.split(":"))))
                dose = store.doses.get(slot_id(med["id"], day, t))
                if dose is None and at > now:
                    continue                    # still to come
                status = dose["status"] if dose else "missed"
                c = meds.setdefault(med["id"], {"med": med, "due": 0, "taken": 0, "skipped": 0, "missed": 0})
                c["due"] += 1
                c[status] += 1
                rows.append((t, med, status, dose["at"] if dose else "", dose["amount"] if dose else amount_at(med, t)))
        for d in store.extra(day):
            med = store.meds.get(d["med"])
            if med:
                needed.setdefault(med["id"], {"med": med, "count": 0})["count"] += 1
                rows.append((d["at"], med, "needed", d["at"], d["amount"]))
        rows.sort(key=lambda r: (r[0], r[1]["name"].lower()))
        if rows:
            days.append((day, rows))
        day += dt.timedelta(days=1)
    changes = []
    for med in store.meds.values():
        for h in med["history"]:
            d = parse_day(h["date"])
            if d and start <= d <= end:
                changes.append((d, med, h["kind"], h.get("detail") or {}))
    changes.sort(key=lambda c: (c[0], c[1]["name"].lower()))
    order = lambda c: c["med"]["name"].lower()
    return {"meds": sorted(meds.values(), key=order), "needed": sorted(needed.values(), key=order),
            "days": days, "changes": changes}


def write_backup(store, path):
    """Everything in one file: the same as dose.json, marked as a Dose backup."""
    doc = dict(store.to_json(), backup={"app": "Dose", "version": VERSION, "made": now_stamp()})
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False, indent=1)
    os.replace(path + ".tmp", path)


def is_backup(doc):
    """A Dose backup, or a dose.json copied by hand: medicines and doses lists."""
    return isinstance(doc, dict) and isinstance(doc.get("medicines"), list) and isinstance(doc.get("doses"), list)


def change_text(med, kind, detail):
    """"Started · 1 pill · Every day at 08:00"."""
    word = {"started": tr("Started"), "changed": tr("Dose changed"), "stopped": tr("Stopped"),
            "restarted": tr("Started again")}[kind]
    if not detail or kind == "stopped":
        return word
    snap = dict(med, **{k: detail[k] for k in detail if k in med})
    snap["schedule"] = clean_schedule(detail.get("schedule"))
    text = schedule_text(snap) if snap["schedule"].get("amounts") else "%s · %s" % (
        fmt_amount(clean_amount(detail.get("amount")), detail.get("unit", "pill")), schedule_text(snap))
    return "%s · %s" % (word, text)


def report_csv(store, start, end, path, now=None):
    """Every dose of the period, one per line, for a spreadsheet."""
    import csv
    data = report_data(store, start, end, now)
    words = {"taken": tr("Taken"), "skipped": tr("Skipped"), "missed": tr("Not taken"), "needed": tr("Taken when needed")}
    with open(path, "w", newline="", encoding="utf-8-sig") as f:      # the BOM lets Excel read the accents
        w = csv.writer(f, delimiter=";" if LANG_CODE == "it" else ",")
        w.writerow([tr("Date"), tr("Time"), tr("Medicine"), tr("Strength"), tr("Amount"), tr("Status"), tr("Taken at")])
        for day, rows in data["days"]:
            for t, med, status, at, amount in rows:
                w.writerow([day.isoformat(), t if status != "needed" else "", med["name"], med["strength"],
                            fmt_amount(amount, med["unit"]), words[status], at if status in ("taken", "needed") else ""])


def report_pdf(store, start, end, path, now=None):
