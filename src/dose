class HistoryPage(Gtk.ScrolledWindow):
    def __init__(self, win):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.win = win
        self.month = today().replace(day=1)
        self.selected = today()
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=18, margin_bottom=24,
                           margin_start=18, margin_end=18)
        clamp = Adw.Clamp(maximum_size=720)
        clamp.set_child(self.box)
        self.set_child(clamp)

    def shift(self, months):
        y, mth = self.month.year, self.month.month + months
        y, mth = y + (mth - 1) // 12, (mth - 1) % 12 + 1
        self.month = dt.date(y, mth, 1)
        self.refresh()

    def pick(self, day):
        self.selected = day
        self.refresh()

    def refresh(self):
        clear(self.box)
        store = self.win.store
        head = Gtk.Box(spacing=6)
        name = MONTHS[self.month.month - 1]
        head.append(make_label("%s %d" % (name, self.month.year), "dose-big", hexpand=True))
        for icon, step, sensitive in (("go-previous-symbolic", -1, True),
                                      ("go-next-symbolic", 1, self.month < today().replace(day=1))):
            b = Gtk.Button(icon_name=icon, valign=Gtk.Align.CENTER, sensitive=sensitive)
            b.add_css_class("flat")
            b.connect("clicked", lambda _b, s=step: self.shift(s))
            head.append(b)
        self.box.append(head)
        grid = Gtk.Grid(column_spacing=6, row_spacing=6, halign=Gtk.Align.CENTER, margin_top=6)
        for i, wd in enumerate(WEEKDAYS):
            grid.attach(make_label(wd, "dim-label caption", xalign=0.5), i, 0, 1, 1)
        day, row = self.month, 1
        while day.month == self.month.month:
            b = Gtk.Button(label=str(day.day))
            b.add_css_class("dose-day")
            due, taken, skipped = store.day_counts(day) if day <= today() else (0, 0, 0)
            if due and day < today() or (day == today() and due and taken == due):
                b.add_css_class("dose-day-all" if taken == due else "dose-day-some" if taken else "dose-day-none")
            elif due and taken:
                b.add_css_class("dose-day-some")
            if day == today():
                b.add_css_class("dose-day-today")
            if day == self.selected:
                b.add_css_class("suggested-action")
            b.set_sensitive(day <= today())
            b.connect("clicked", lambda _b, d=day: self.pick(d))
            grid.attach(b, day.weekday(), row, 1, 1)
            if day.weekday() == 6:
                row += 1
            day += dt.timedelta(days=1)
        self.box.append(grid)
        legend = Gtk.Box(spacing=14, halign=Gtk.Align.CENTER, margin_top=4)
        for css, text in (("dose-day-all", tr("All taken")), ("dose-day-some", tr("Some")),
                          ("dose-day-none", tr("None marked"))):
            item = Gtk.Box(spacing=5)
            dot = Gtk.Box(valign=Gtk.Align.CENTER)
            dot.add_css_class("dose-dot")
            dot.add_css_class(css)
            item.append(dot)
            item.append(make_label(text, "dim-label caption"))
            legend.append(item)
        self.box.append(legend)
        self.box.append(make_label(fmt_day(self.selected, long=True, year=True), "title-3", margin_top=14))
        col, anything = day_list(self.win, self.selected, store)
        self.box.append(col if anything else make_label(tr("Nothing scheduled on this day."), "dim-label"))
        changes = sorted(((h["date"], med, h) for med in store.meds.values() for h in med["history"]),
                         key=lambda x: (x[0], x[1]["name"].lower()), reverse=True)
        if changes:
            self.box.append(make_label(tr("Changes"), "dose-part"))
            lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            lb.add_css_class("boxed-list")
            for date, med, h in changes[:60]:
                kind = {"started": tr("Started"), "changed": tr("Dose changed"), "stopped": tr("Stopped"),
                        "restarted": tr("Started again")}[h["kind"]]
                detail = h.get("detail") or {}
                text = ""
                if detail and h["kind"] != "stopped":
                    snap = dict(med, **{k: detail[k] for k in detail if k in med})
                    snap["schedule"] = clean_schedule(detail.get("schedule"))
                    text = "%s · %s" % (fmt_amount(clean_amount(detail.get("amount")), detail.get("unit", "pill")),
                                        schedule_text(snap))
                row = Adw.ActionRow(title=GLib.markup_escape_text("%s · %s" % (kind, med["name"])),
                                    subtitle=GLib.markup_escape_text(
                                        fmt_date(parse_day(date)) + (" · " + text if text else "")))
                lb.append(row)
            self.box.append(lb)


