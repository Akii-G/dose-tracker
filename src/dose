class ReportWindow(Gtk.Window):
    """A period, then the report as a PDF (to print or send to the doctor) or a CSV."""

    PERIODS = [(7, tr("Last 7 days")), (14, tr("Last 2 weeks")), (30, tr("Last 30 days")),
               (90, tr("Last 3 months")), (0, tr("Choose the dates"))]

    def __init__(self, win):
        super().__init__(transient_for=win, modal=True, title=tr("Report for your doctor"), default_width=460)
        self.win = win
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=20,
                      margin_start=20, margin_end=20)
        self.set_child(col)
        col.append(make_label(tr("For each medicine: the doses taken, skipped and not taken, those taken when "
                                 "needed and the changes; then the doses day by day."), "dim-label", wrap=True))
        lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        lb.add_css_class("boxed-list")
        row = Adw.ActionRow(title=tr("Period"))
        self.period = Gtk.DropDown.new_from_strings([label for _n, label in self.PERIODS])
        self.period.set_selected(2)
        self.period.set_valign(Gtk.Align.CENTER)
        self.period.connect("notify::selected", lambda *_: self.update())
        row.add_suffix(self.period)
        lb.append(row)
        self.from_row = Adw.ActionRow(title=tr("From"))
        self.start = DateButton(today() - dt.timedelta(days=29))
        self.start.set_valign(Gtk.Align.CENTER)
        self.from_row.add_suffix(self.start)
        lb.append(self.from_row)
        self.to_row = Adw.ActionRow(title=tr("Until"))
        self.end = DateButton(today())
        self.end.set_valign(Gtk.Align.CENTER)
        self.to_row.add_suffix(self.end)
        lb.append(self.to_row)
        col.append(lb)
        buttons = Gtk.Box(spacing=10, halign=Gtk.Align.END)
        csv_b = Gtk.Button(label=tr("Save as CSV"))
        csv_b.connect("clicked", lambda *_: self.save("csv"))
        pdf_b = Gtk.Button(label=tr("Save as PDF"))
        pdf_b.add_css_class("suggested-action")
        pdf_b.connect("clicked", lambda *_: self.save("pdf"))
        buttons.append(csv_b)
        buttons.append(pdf_b)
        col.append(buttons)
        self.update()

    def update(self):
        custom = self.PERIODS[self.period.get_selected()][0] == 0
        self.from_row.set_visible(custom)
        self.to_row.set_visible(custom)

    def dates(self):
        n = self.PERIODS[self.period.get_selected()][0]
        if n:
            return today() - dt.timedelta(days=n - 1), today()
        start, end = self.start.day or today(), self.end.day or today()
        return min(start, end), max(start, end)

    def save(self, kind):
        start, end = self.dates()
        name = "%s-%s-%s.%s" % (tr("Dose-report"), start.isoformat(), end.isoformat(), kind)

        def write(path):
            if not path.lower().endswith("." + kind):
                path += "." + kind
            try:
                (report_pdf if kind == "pdf" else report_csv)(self.win.store, start, end, path)
            except OSError as err:
                self.win.message(tr("Could not save: %s") % (err.strerror or err))
                return
            self.close()
            if kind == "pdf":
                self.win.open_with_app(path)
            else:
                self.win.message(tr("Saved: %s") % os.path.basename(path))
        self.win.pick_file(tr("Save the report"), "save", write, name)


