def toned(css, tone=None):
    """The CSS in another colour tone: Dose's violets swapped for the tone's colours."""
    tone = tone or prefs().get("tone", "violet")
    t = next((x for x in TONES if x[0] == tone), TONES[0])
    for old, new in zip(TONES[0][2:], t[2:]):
        css = css.replace(old, "@@" + new[1:])
    return css.replace("@@", "#")


