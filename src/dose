                       8, color=grey, width=W - 2 * M) + 18

    # summary per medicine
    cols = [(M, tr("Medicine")), (M + 250, tr("Taken")), (M + 305, tr("Skipped")), (M + 365, tr("Not taken")), (M + 430, tr("% taken"))]
    state["y"] += text(M, state["y"], tr("Scheduled doses"), 13, True) + 6
    if not data["meds"]:
        state["y"] += text(M, state["y"], tr("No scheduled doses in this period."), 10, color=grey) + 10
    else:
        for x, label in cols:
            text(x, state["y"], label, 8, True, grey, width=60 if x > M else None)
        state["y"] += 16
        rule(state["y"])
        state["y"] += 6
        for c in data["meds"]:
            med = c["med"]
            name = med_title(med) + (" (" + tr("stopped") + ")" if med["archived"] else "")
            sub = schedule_text(med) if med["schedule"].get("amounts") else \
                "%s · %s" % (fmt_amount(med["amount"], med["unit"]), schedule_text(med))
            need(40)
            h = text(M, state["y"], name, 10, True, width=240)
            h += text(M, state["y"] + h, sub, 8, color=grey, width=240)
            pct = round(100 * c["taken"] / c["due"]) if c["due"] else 0
            for (x, _l), value, color in zip(cols[1:], (c["taken"], c["skipped"], c["missed"], "%d%%" % pct),
                                             (ink, ink, red if c["missed"] else ink, violet)):
                text(x, state["y"], str(value), 10, x == cols[-1][0], color)
            state["y"] += max(h, 14) + 6
            rule(state["y"] - 3)
        state["y"] += 10

    if data["needed"]:
        need(40)
        state["y"] += text(M, state["y"], tr("Taken when needed"), 13, True) + 6
        for c in data["needed"]:
            need(18)
            state["y"] += text(M, state["y"], "%s · %s" % (med_title(c["med"]), trn("%d time", "%d times", c["count"]) % c["count"]),
                               10, width=W - 2 * M) + 4
        state["y"] += 10

    if data["changes"]:
        need(40)
        state["y"] += text(M, state["y"], tr("Changes"), 13, True) + 6
        for day, med, kind, detail in data["changes"]:
            need(18)
            text(M, state["y"], fmt_date(day), 9, color=grey)
            state["y"] += text(M + 90, state["y"], "%s · %s" % (med_title(med), change_text(med, kind, detail)),
                               9, width=W - 2 * M - 90) + 4
        state["y"] += 10

    # day by day
    need(40)
    state["y"] += text(M, state["y"], tr("Day by day"), 13, True) + 6
    words = {"taken": tr("Taken at %s"), "skipped": tr("Skipped"), "missed": tr("Not taken"), "needed": tr("When needed, at %s")}
    for day, rows in reversed(data["days"]):
        need(22 + 14 * min(len(rows), 3))
        state["y"] += text(M, state["y"], fmt_day(day, long=True, year=True), 10, True, violet) + 3
        for t, med, status, at, amount in rows:
            need(14)
            word = words[status] % at if "%s" in words[status] else words[status]
            text(M + 10, state["y"], t if status != "needed" else "", 9, color=grey)
            text(M + 55, state["y"], "%s · %s" % (med_title(med), fmt_amount(amount, med["unit"])), 9, width=280)
            state["y"] += text(M + 345, state["y"], word, 9, status == "taken",
                               red if status == "missed" else violet if status in ("taken", "needed") else grey,
                               width=W - 2 * M - 345) + 3
        state["y"] += 6
    footer()
    surface.finish()


# The AIC number (9 digits, "A012345678" on the box) names one pack of one medicine. Boxes carry
# it as a Code 39 barcode ("A012345678"), as Code 32 (the same number in base 32, 6 characters,
# read by scanners as Code 39) and, since 2025, in the GS1 DataMatrix under AI (716).

CODE32 = "0123456789BCDFGHJKLMNPQRSTUVWXYZ"


def aic_from_text(text):
    """An AIC typed by hand: "A012345678", "012345678", "A 012345678" -> "012345678"."""
    t = re.sub(r"[\s.\-]", "", text or "").upper()
    m = re.fullmatch(r"A?(\d{9})", t)
    return m.group(1) if m else None


def aic_from_barcode(payload):
    """The AIC in what a scanner read, or None: Code 39 ("A012345678"), Code 32 (6 characters),
    or a GS1 DataMatrix with AI (716)."""
    p = (payload or "").strip()
    if p.startswith("]"):                          # symbology identifier: ]d2, ]C1, ]A0…
        p = p[3:]
    code = aic_from_text(p)
    if code:
        return code
    if len(p) == 6 and all(c in CODE32 for c in p.upper()):
        n = 0
        for c in p.upper():
            n = n * 32 + CODE32.index(c)
        return "%09d" % n if n < 10 ** 9 else None
    # GS1: fields with fixed lengths, then variable ones that end at a group separator
    fixed = {"00": 18, "01": 14, "02": 14, "11": 6, "12": 6, "13": 6, "15": 6, "16": 6, "17": 6}
    rest = p
    i = 0
    while i < len(rest):
        if rest[i] == "\x1d":
            i += 1
            continue
        ai = rest[i:i + 2]
        if ai in fixed:
            i += 2 + fixed[ai]
            continue
        end = rest.find("\x1d", i)
        end = len(rest) if end < 0 else end
        field = rest[i:end]
        if field.startswith("716"):
            digits = re.sub(r"\D", "", field[3:])
            return digits[-9:].zfill(9) if digits else None
        i = end
    m = re.search(r"716(\d{9})(?!\d)", p)
    return m.group(1) if m else None


def find_aic(code):
    """The medicine line of an AIC pack, or of another pack of the same medicine."""
    farmaco, pack = code[:6], code[6:]
    near = None
    for name, strength, form, ingredient, _f, _i, packs in medicines():
        for group in packs.split(";") if packs else ():
            head, _sep, tails = group.partition(":")
            if head == farmaco:
                if pack in tails.split(","):
                    return (name, strength, form, ingredient)
                near = near or (name, strength, form, ingredient)
    return near


# ----------------------------------------------------------------- encrypted sync
#
# The same scheme as Sottovoce: AES-256-GCM with a key derived from the shared token
# (HKDF-SHA256), so the token never crosses the network. A message is JSON {"v": 1, "n":
# base64 nonce, "c": base64 ciphertext+tag}; the additional data binds it to its endpoint
# and direction. ios/Dose/SyncCrypto.swift must match; ios/CryptoCheck checks both.

SYNC_SALT, SYNC_INFO = b"dose-sync", b"dose sync v1"


def sync_key(token):
    from cryptography.hazmat.primitives import hashes
    from cryptography.hazmat.primitives.kdf.hkdf import HKDF
    return HKDF(algorithm=hashes.SHA256(), length=32, salt=SYNC_SALT, info=SYNC_INFO).derive(token.encode("utf-8"))


def sync_aad(path, reply):
    return ("dose/v1 %s %s" % ("reply" if reply else "request", path)).encode("utf-8")


def seal(token, path, obj, reply=False, nonce=None):
    import base64
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    nonce = nonce or secrets.token_bytes(12)
    data = AESGCM(sync_key(token)).encrypt(nonce, json.dumps(obj, ensure_ascii=False).encode("utf-8"),
                                           sync_aad(path, reply))
    return json.dumps({"v": 1, "n": base64.b64encode(nonce).decode(), "c": base64.b64encode(data).decode()}).encode()


def unseal(token, path, body, reply=False):
    import base64, binascii
    from cryptography.exceptions import InvalidTag
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    try:
        doc = json.loads(body)
        nonce, data = base64.b64decode(doc["n"]), base64.b64decode(doc["c"])
        if doc.get("v") != 1 or len(nonce) != 12:
            raise ValueError("unknown format")
        return json.loads(AESGCM(sync_key(token)).decrypt(nonce, data, sync_aad(path, reply)))
    except (KeyError, TypeError, binascii.Error, InvalidTag, UnicodeDecodeError, ValueError, AttributeError) as err:
        raise ValueError("not readable with this token") from err


def crypto_available():
    try:
        import cryptography.hazmat.primitives.ciphers.aead  # noqa: F401
        return True
    except ImportError:
        return False


def sync_config():
    """Token and port for the phone sync (created on first use, readable only by you)."""
    path = os.path.join(data_dir(), "sync.json")
    try:
        with open(path, encoding="utf-8") as f:
            cfg = json.load(f)
        if isinstance(cfg.get("token"), str) and len(cfg["token"]) >= 16:
            cfg.setdefault("port", SYNC_PORT)
            return cfg
    except (OSError, ValueError, AttributeError):
        pass
    return new_sync_token(port=SYNC_PORT)


def new_sync_token(port=None):
    path = os.path.join(data_dir(), "sync.json")
    cfg = {"token": secrets.token_urlsafe(18), "port": port or sync_config().get("port", SYNC_PORT)}
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(cfg, f)
    os.replace(path + ".tmp", path)
    return cfg


def lan_address():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("192.0.2.1", 9))   # no packet is sent; it only picks the LAN interface
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return None


def sync_status_path():
    return os.path.join(data_dir(), "sync-last.txt")


def sync_with_phone(doc):
    """Merge what the phone sent into dose.json and return the merged state."""
    store = Store()
    changed = store.absorb(doc if isinstance(doc, dict) else {})
    if changed:
        store.save()
    state = store.to_json()
    state["changed"] = changed
    return state


def make_server(port):
    import http.server

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "Dose/" + VERSION

        def send(self, code, body, kind="application/json"):
            self.send_response(code)
            self.send_header("Content-Type", kind)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def error(self, code, message):
            self.send(code, json.dumps({"error": message}).encode("utf-8"))

        def do_GET(self):
            self.send(200, b"Dose sync is running.\n", "text/plain")

        def do_POST(self):
            route = self.path.split("?", 1)[0].rstrip("/")
            if not prefs()["sync"]:
                self.error(403, tr("Phone sync is switched off in Dose on your PC."))
                return
            if not crypto_available():
                self.error(501, tr("Sync needs the python3-cryptography package on the PC."))
                return
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                length = 0
            if not 0 < length <= 30 * 1024 * 1024:
                self.error(400, tr("Empty request, or too large."))
                return
            token = sync_config()["token"]
            try:
                doc = unseal(token, route, self.rfile.read(length))
            except ValueError:
                self.error(401, tr("The token doesn't match. Copy it again from Dose on your PC."))
                return
            if route == "/api/e/ping":
                answer = {"app": "Dose", "version": VERSION}
            elif route == "/api/e/sync":
                answer = sync_with_phone(doc)
                device = str(doc.get("device") or "") if isinstance(doc, dict) else ""
                try:
                    with open(sync_status_path(), "w", encoding="utf-8") as f:
                        f.write("%s\n%s\n%d\n" % (dt.datetime.now().strftime("%Y-%m-%d %H:%M"), device[:60],
                                                  answer["changed"]))
                except OSError:
                    pass
            else:
                self.error(404, "unknown")
                return
            self.send(200, seal(token, route, answer, reply=True))

        def log_message(self, fmt, *args):
            sys.stderr.write("dose-sync: %s\n" % (fmt % args))

    class Server(http.server.ThreadingHTTPServer):
        def server_bind(self):
            # HTTPServer looks this computer's name up (socket.getfqdn), which can hang for
            # minutes when the network's DNS doesn't answer (it did on a Mac): not needed here
            import socketserver
            socketserver.TCPServer.server_bind(self)
            self.server_name, self.server_port = self.server_address[:2]

    server = Server(("0.0.0.0", port), Handler)
    server.daemon_threads = True
    return server


# ----------------------------------------------------------------- reminders on this PC
#
# `dose --background` (the dose-background user service) checks every 30 seconds for doses
# that are due and not marked yet, and shows a notification with Taken and Later buttons
# (notify-send). One reminder at the time, and one more 30 minutes later if follow-ups are on.

def notified_path():
    return os.path.join(data_dir(), "notified.json")


def due_now(store, now, follow_up, snoozed):
    """[(key, time, [meds], again)] reminders to show at `now`, grouped by time."""
    day = now.date()
    groups = {}
    for t, med, dose in store.slots(day):
        if dose:
            continue
        at = dt.datetime.combine(day, dt.time(int(t[:2]), int(t[3:])))
        if now < at or now - at > dt.timedelta(hours=3):
            continue
        groups.setdefault(t, []).append(med)
    out = []
    for t, meds in sorted(groups.items()):
        at = dt.datetime.combine(day, dt.time(int(t[:2]), int(t[3:])))
        key = "%s %s" % (day.isoformat(), t)
        state = snoozed.get(key)
        if state is None:
            out.append((key, t, meds, False))
        elif state.get("until") and now.timestamp() >= state["until"]:
            out.append((key, t, meds, True))
        elif follow_up and not state.get("again") and now - at >= dt.timedelta(minutes=30) \
                and not state.get("until"):
            out.append((key, t, meds, True))
    return out


def reminder_text(t, meds, discreet):
    if discreet:
        return tr("Dose"), tr("Time for your %s dose") % t
    names = ", ".join(m["name"] + (" " + m["strength"] if m["strength"] else "") for m in meds)
    amounts = ""
    if len(meds) == 1:
        amounts = " · " + fmt_amount(amount_at(meds[0], t), meds[0]["unit"])
    return tr("%s · time for your medicine") % t, names + amounts


def notify(title, body, actions, day=None, t=None):
    """notify-send with buttons; returns the chosen action or None. Blocks until answered.
    On Windows a toast instead: its buttons open dose:taken?… or dose:later?…, which a new
    Dose process handles (see handle_link), so this returns None at once."""
    if IS_WINDOWS:
        win_toast(title, body, day, t, actions)
        return None
    if IS_MAC:
        return mac_notify(title, body, actions)
    exe = shutil.which("notify-send")
    if not exe:
        return None
    args = [exe, "-a", "Dose", "-i", APP_ID, "-u", "normal"]
    for key, label in actions:
        args += ["-A", "%s=%s" % (key, label)]
    try:
        out = subprocess.run(args + [title, body], capture_output=True, text=True, timeout=6 * 3600)
        if out.returncode != 0 and actions:     # an older notify-send without buttons
            subprocess.run([exe, "-a", "Dose", "-i", APP_ID, title, body], timeout=30)
            return None
        return out.stdout.strip() or None
    except (OSError, subprocess.SubprocessError):
        return None


def run_background():
    """Reminders, and the phone sync while it's switched on. Runs until stopped."""
    server, server_thread = None, None
    try:
        with open(notified_path(), encoding="utf-8") as f:
            seen = json.load(f)
    except (OSError, ValueError):
        seen = {}
    lock = threading.Lock()

    def answer(key, day, t, meds):
        p = prefs()
        title, body = reminder_text(t, meds, p["discreet"])
        choice = notify(title, body, [("taken", tr("Taken")), ("later", tr("Later"))], day.isoformat(), t)
        with lock:
            if choice == "taken":
                store = Store()
                for m in meds:
                    if not store.doses.get(slot_id(m["id"], day, t)):
                        store.mark(m["id"], day, t, "taken")
                store.save()
            elif choice == "later":
                seen[key] = {"until": time.time() + 10 * 60, "again": False}
                save_seen()

    def save_seen():
        try:
            cut = (today() - dt.timedelta(days=2)).isoformat()
            for k in [k for k in seen if k < cut]:
                del seen[k]
            with open(notified_path(), "w", encoding="utf-8") as f:
                json.dump(seen, f)
        except OSError:
            pass

    if IS_WINDOWS:
        win_write_pid()
    while True:
        p = prefs()
        if IS_WINDOWS:    # "Later" in a toast is answered by another Dose process: read what it wrote
            try:
                with open(notified_path(), encoding="utf-8") as f:
                    disk = json.load(f)
                with lock:
                    for k, v in disk.items():
                        if isinstance(v, dict) and v.get("until", 0) > seen.get(k, {}).get("until", 0):
                            seen[k] = v
            except (OSError, ValueError):
                pass
        if p["sync"] and server is None and crypto_available():
            try:
                server = make_server(int(sync_config().get("port", SYNC_PORT)))
                server_thread = threading.Thread(target=server.serve_forever, daemon=True)
                server_thread.start()
                print("Dose sync listening on port %d" % server.server_address[1], flush=True)
            except OSError as err:
                print("Dose sync can't start: %s" % err, flush=True)
                server = None
        elif not p["sync"] and server is not None:
            server.shutdown()
            server.server_close()
            server = None
        if p["remind"]:
            now = dt.datetime.now()
            store = Store()
            with lock:
                todo = due_now(store, now, p["follow_up"], seen)
                for key, t, meds, again in todo:
                    seen[key] = {"until": 0, "again": again}
                if todo:
                    save_seen()
            for key, t, meds, again in todo:
                threading.Thread(target=answer, args=(key, now.date(), t, meds), daemon=True).start()
        time.sleep(30)


