        add = Gtk.Button(icon_name="list-add-symbolic", tooltip_text=tr("Add a medicine"))
        add.connect("clicked", lambda *_: self.edit(None))
        header.pack_start(add)
        menu = Gio.Menu()
        menu.append(tr("Report for your doctor…"), "win.report")
        menu.append(tr("Phone sync"), "win.sync")
        data = Gio.Menu()
        data.append(tr("Back up…"), "win.backup")
        data.append(tr("Restore from a backup…"), "win.restore")
        menu.append_section(None, data)
        more = Gio.Menu()
        more.append(tr("Preferences"), "win.prefs")
        more.append(tr("About Dose"), "win.about")
        menu.append_section(None, more)
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu))
        for name, cb in (("sync", lambda *_: SyncWindow(self).present()),
                         ("report", lambda *_: ReportWindow(self).present()),
                         ("backup", lambda *_: self.on_backup()),
                         ("restore", lambda *_: self.on_restore()),
                         ("prefs", lambda *_: PrefsWindow(self).present()),
                         ("about", lambda *_: self.about())):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", cb)
            self.add_action(action)
        root.append(header)
        root.append(self.stack)
        self.set_content(root)
        self.refresh()
        GLib.timeout_add_seconds(2, self.watch)
        self.minute = dt.datetime.now().strftime("%H:%M")

    def watch(self):
        """Pick up changes from the phone or a reminder, and the clock passing a dose time."""
        now = dt.datetime.now().strftime("%H:%M")
        if self.store.changed_on_disk():
            self.store.load()
            self.refresh()
        elif now != self.minute:
            self.today.refresh()
        self.minute = now
        return True

    def refresh(self):
        self.today.refresh()
        self.meds.refresh()
        self.history.refresh()

    # -- files: report, backup, restore

    def message(self, text):
        if hasattr(Gtk, "AlertDialog"):  # GTK 4.10 and newer
            Gtk.AlertDialog(message=text).show(self)
        else:
            print(text)

    def pick_file(self, title, mode, callback, name=None):
        """A file to save or open, on old and new GTK 4. mode: save or open."""
        if hasattr(Gtk, "FileDialog"):
            dialog = Gtk.FileDialog(title=title)
            if name:
                dialog.set_initial_name(name)
            start, finish = (dialog.save, dialog.save_finish) if mode == "save" else (dialog.open, dialog.open_finish)

            def done(_d, result):
                try:
                    gfile = finish(result)
                except GLib.Error:
                    return              # cancelled
                if gfile and gfile.get_path():
                    callback(gfile.get_path())
            start(self, None, done)
            return
        chooser = Gtk.FileChooserNative.new(title, self, Gtk.FileChooserAction.SAVE if mode == "save"
                                            else Gtk.FileChooserAction.OPEN, None, None)
        if name:
            chooser.set_current_name(name)

        def response(dialog, answer):
            if answer == Gtk.ResponseType.ACCEPT and dialog.get_file():
                callback(dialog.get_file().get_path())
            self._chooser = None
        chooser.connect("response", response)
        self._chooser = chooser          # keep it alive while open
        chooser.show()

    def open_with_app(self, path):
        """Opens a file just made (the PDF) in the app that shows it."""
        try:
            if IS_MAC:
                subprocess.Popen(["open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            else:
                Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(path).get_uri(), None)
        except GLib.Error:
            pass

    def on_backup(self):
        def write(path):
            if not path.lower().endswith(".json"):
                path += ".json"
            try:
                write_backup(self.store, path)
            except OSError as err:
                self.message(tr("Could not save: %s") % (err.strerror or err))
                return
            self.message(tr("Saved: %s. Keep it somewhere safe, like a USB stick or your cloud.") % os.path.basename(path))
        self.pick_file(tr("Back up"), "save", write, "Dose-backup-%s.json" % today().isoformat())

    def on_restore(self):
        def read(path):
            try:
                with open(path, encoding="utf-8") as f:
                    doc = json.load(f)
            except (OSError, ValueError):
                doc = None
            if not is_backup(doc):
                self.message(tr("This isn't a Dose backup."))
                return
            changes = []
            self.change(lambda s: changes.append(s.absorb(doc)))
            self.message(trn("Restored: %d change.", "Restored: %d changes.", changes[0]) % changes[0] + " " +
                         tr("What you had here stays; the backup only adds what's missing or newer."))
        self.pick_file(tr("Restore from a backup"), "open", read)

    def change(self, fn):
        if self.store.changed_on_disk():
            self.store.load()
        fn(self.store)
        try:
            self.store.save()
        except OSError as err:
            print("Dose: could not save: %s" % err, file=sys.stderr)
        self.refresh()

    def edit(self, med_id):
        Editor(self, med_id).present()

    def about(self):
        about = Adw.AboutWindow(transient_for=self, application_name="Dose", application_icon=APP_ID,
                                version=VERSION, website="https://github.com/Akii-G/dose-tracker",
                                comments=tr("Your medicines, quietly. The sister app of Sottovoce."),
                                license_type=Gtk.License.MIT_X11) if hasattr(Adw, "AboutWindow") else None
        if about:
            about.present()


def _make_app_class():
    class _App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

        def do_activate(self):
            win = self.get_active_window()
            if not win:
                # the app's icon when it isn't installed in the system (Windows, or from source)
                theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
                dirs = [os.path.join(here(), "..", "data"), os.path.join(here(), "..", "data", "icons")]
                if getattr(sys, "_MEIPASS", None):
                    dirs.insert(0, os.path.join(sys._MEIPASS, "share", "icons"))
                for d in dirs:
                    if os.path.isdir(d):
                        theme.add_search_path(d)
                apply_style()
                Adw.StyleManager.get_default().connect("notify::dark", lambda *_: apply_style())
                threading.Thread(target=start_background, daemon=True).start()
                win = MainWindow(self)
            win.present()
    return _App


