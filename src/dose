            word = (tr("Taken at %s") if dose["status"] == "taken" else tr("Skipped")) % dose["at"] \
                if dose["status"] == "taken" else tr("Skipped")
            box.append(make_label(word, "dose-taken" if dose["status"] == "taken" else "dose-skipped"))
            undo = Gtk.Button(icon_name="edit-undo-symbolic", valign=Gtk.Align.CENTER, tooltip_text=tr("Undo"))
            undo.add_css_class("flat")
            undo.connect("clicked", lambda *_: win.change(lambda s: s.unmark(dose["id"])))
            box.append(undo)
        else:
            late = day < today() or (day == today() and dt.datetime.now().strftime("%H:%M") > time_)
            if late:
                box.append(make_label(tr("Not marked"), "dose-late caption"))
            skip = Gtk.Button(label=tr("Skip"), valign=Gtk.Align.CENTER)
            skip.connect("clicked", lambda *_: self.mark("skipped"))
            taken = Gtk.Button(label=tr("Taken"), valign=Gtk.Align.CENTER)
            taken.add_css_class("suggested-action")
            taken.connect("clicked", lambda *_: self.mark("taken"))
            other = Gtk.MenuButton(icon_name="view-more-symbolic", valign=Gtk.Align.CENTER,
                                   tooltip_text=tr("Taken at another time"))
            other.add_css_class("flat")
            pop = Gtk.Popover()
            pbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=10, margin_bottom=10,
                           margin_start=10, margin_end=10)
