def run_app():
    Adw.init()
    app = _make_app_class()()
    return app.run([sys.argv[0]])


def main():
    if "--version" in sys.argv:
        print("Dose " + VERSION)
        return 0
    if "--background" in sys.argv:
        mac_hide_from_dock()      # again: GTK may have made it a Dock app while starting
        run_background()
        return 0
    if "--resume-background" in sys.argv:     # run by the Windows installer after an update
        if IS_WINDOWS and win_autostart_on():
            win_set_autostart(True)
            win_start_background()
        return 0
    links = [a for a in sys.argv[1:] if a.lower().startswith("dose:")]
    if links and handle_link(links[0]):
        return 0
    return run_app()



# ----------------------------------------------------------------- Mac
# `Dose --background` is a launchd agent in ~/Library/LaunchAgents (started at login and kept
# running). A reminder is a small macOS dialog with Taken and Later, through AppleScript: the
# simplest way that works for an app that isn't signed by Apple.
MAC_LABEL = "app.dose.Dose.background"


def mac_agent_path():
    return os.path.expanduser("~/Library/LaunchAgents/%s.plist" % MAC_LABEL)


def mac_launchctl(*args):
    try:
        done = subprocess.run(["launchctl"] + list(args), capture_output=True, text=True, timeout=20)
        return done.returncode == 0, (done.stderr or done.stdout).strip()
    except (OSError, subprocess.SubprocessError) as err:
        return False, str(err)


def mac_domain():
    return "gui/%d" % os.getuid()


def mac_background_on():
    """Writes the agent that runs `Dose --background` (this copy of Dose) and (re)loads it."""
    import plistlib
    path = mac_agent_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    agent = {"Label": MAC_LABEL, "ProgramArguments": self_command("--background"),
             "RunAtLoad": True, "KeepAlive": True, "ProcessType": "Interactive",
             "StandardOutPath": os.path.join(config_dir(), "background.log"),
             "StandardErrorPath": os.path.join(config_dir(), "background.log")}
    env = {k: os.environ[k] for k in ("DOSE_DATA_DIR", "DOSE_CONFIG_DIR", "DOSE_LANG") if os.environ.get(k)}
    if env:
        agent["EnvironmentVariables"] = env
    with open(path, "wb") as f:
        plistlib.dump(agent, f)
    mac_launchctl("bootout", "%s/%s" % (mac_domain(), MAC_LABEL))
    return mac_launchctl("bootstrap", mac_domain(), path)


def mac_agent_args():
    import plistlib
    try:
        with open(mac_agent_path(), "rb") as f:
            return plistlib.load(f).get("ProgramArguments")
    except (OSError, ValueError, plistlib.InvalidFileException):
        return None


def mac_background_off():
    mac_launchctl("bootout", "%s/%s" % (mac_domain(), MAC_LABEL))
    try:
        os.remove(mac_agent_path())
    except OSError:
        pass


def mac_background_running():
    ok, out = mac_launchctl("print", "%s/%s" % (mac_domain(), MAC_LABEL))
    return ok and "state = running" in out


def mac_notify(title, body, actions=()):
    """A dialog with the reminder's buttons (Taken, Later); returns the chosen key, or None.
    Without buttons, a notification."""
    def q(text):
        return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'
    if not actions:
        script = "display notification %s with title %s sound name \"default\"" % (q(body), q(title))
    else:
        labels = [label for _key, label in actions]
        script = ("display dialog %s with title %s buttons {%s} default button %s with icon note "
                  "giving up after 21600" % (q(body), q(title), ", ".join(q(l) for l in reversed(labels)), q(labels[0])))
    try:
        done = subprocess.run(["osascript", "-e", script], capture_output=True, text=True, timeout=6 * 3600 + 60)
    except (OSError, subprocess.SubprocessError):
        return None
    chosen = re.search(r"button returned:([^,]*)", done.stdout or "")
    if not chosen:
        return None
    for key, label in actions:
        if label == chosen.group(1).strip():
            return key
    return None

# ----------------------------------------------------------------- Windows
# No systemd and no notify-send: `Dose.exe --background` starts at login from the "Run" key
# (and is found again by its process id), and reminders are Windows notifications (toasts)
# whose buttons open dose:taken?… and dose:later?… links, registered by the installer.
WIN_APP_ID = "Dose.Dose"          # the Start menu shortcut carries this id (installer)
WIN_RUN_KEY = r"Software\Microsoft\Windows\CurrentVersion\Run"
WIN_RUN_NAME = "Dose reminders"
NO_WINDOW = 0x08000000 if IS_WINDOWS else 0   # CREATE_NO_WINDOW


def self_command(*args):
    """The command that runs Dose again: Dose.exe when installed, else Python with this script."""
    if getattr(sys, "frozen", False):
        return [sys.executable] + list(args)
    return [sys.executable, os.path.realpath(os.path.abspath(sys.argv[0]))] + list(args)


def handle_link(link):
    """dose:taken?day=…&time=… marks the doses of that time; dose:later?… asks again in 10
    minutes; dose:open (or anything else) opens the window. Returns True when handled here."""
    from urllib.parse import parse_qs, urlsplit
    parts = urlsplit(link)
    what = (parts.path or parts.netloc).strip("/").lower()
    q = {k: v[0] for k, v in parse_qs(parts.query).items()}
    day, t = parse_day(q.get("day")), q.get("time", "")
    if what not in ("taken", "later") or not day or not TIME_RE.match(t):
        return False
    if what == "taken":
        store = Store()
        for slot_time, med, dose in store.slots(day):
            if slot_time == t and not dose:
                store.mark(med["id"], day, t, "taken")
        store.save()
    else:
        try:
            with open(notified_path(), encoding="utf-8") as f:
                seen = json.load(f)
        except (OSError, ValueError):
            seen = {}
        seen["%s %s" % (day.isoformat(), t)] = {"until": time.time() + 10 * 60, "again": False}
        with open(notified_path() + ".tmp", "w", encoding="utf-8") as f:
            json.dump(seen, f)
        os.replace(notified_path() + ".tmp", notified_path())
    return True


def win_run(cmd):
    try:
        done = subprocess.run(cmd, capture_output=True, text=True, timeout=30, creationflags=NO_WINDOW)
        return done.returncode == 0, (done.stderr or done.stdout).strip()
    except (OSError, subprocess.SubprocessError) as err:
        return False, str(err)


def toast_xml(title, body, day=None, t=None, actions=()):
    def esc(text):
        return (text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;"))
    buttons = ""
    if day and t and actions:
        buttons = "<actions>%s</actions>" % "".join(
            '<action content="%s" activationType="protocol" arguments="dose:%s?day=%s&amp;time=%s"/>'
            % (esc(label), key, day, t) for key, label in actions)
    return ('<toast activationType="protocol" launch="dose:open"%s>'
            '<visual><binding template="ToastGeneric"><text>%s</text><text>%s</text></binding></visual>%s</toast>'
            % (' scenario="reminder"' if buttons else "", esc(title), esc(body), buttons))


def win_toast(title, body, day=None, t=None, actions=()):
    """A Windows notification with buttons; Windows opens dose: links for them."""
    xml = toast_xml(title, body, day, t, actions)
    script = (
        "[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] > $null\n"
        "[Windows.Data.Xml.Dom.XmlDocument, Windows.Data.Xml.Dom.XmlDocument, ContentType = WindowsRuntime] > $null\n"
        "$x = New-Object Windows.Data.Xml.Dom.XmlDocument\n"
        "$x.LoadXml('%s')\n"
        "[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier('%s').Show("
        "[Windows.UI.Notifications.ToastNotification]::new($x))\n" % (xml.replace("'", "''"), WIN_APP_ID))
    import base64
    encoded = base64.b64encode(script.encode("utf-16-le")).decode("ascii")
    return win_run(["powershell.exe", "-NoProfile", "-NonInteractive", "-WindowStyle", "Hidden",
                    "-EncodedCommand", encoded])


def win_pid_path():
    return os.path.join(data_dir(), "background.pid")


def win_write_pid():
    try:
        with open(win_pid_path(), "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass


def win_pid_alive(pid):
    import ctypes
    kernel = ctypes.windll.kernel32
    handle = kernel.OpenProcess(0x1000, False, pid)     # PROCESS_QUERY_LIMITED_INFORMATION
    if not handle:
        return False
    code = ctypes.c_ulong()
    ok = kernel.GetExitCodeProcess(handle, ctypes.byref(code))
    kernel.CloseHandle(handle)
    return bool(ok) and code.value == 259                # STILL_ACTIVE


def win_background_running():
    try:
        with open(win_pid_path()) as f:
            return win_pid_alive(int(f.read().strip()))
    except (OSError, ValueError):
        return False


def win_set_autostart(on):
    import winreg
    with winreg.CreateKey(winreg.HKEY_CURRENT_USER, WIN_RUN_KEY) as key:
        if on:
            winreg.SetValueEx(key, WIN_RUN_NAME, 0, winreg.REG_SZ, subprocess.list2cmdline(self_command("--background")))
        else:
            try:
                winreg.DeleteValue(key, WIN_RUN_NAME)
            except OSError:
                pass


def win_autostart_on():
    try:
        import winreg
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, WIN_RUN_KEY) as key:
            winreg.QueryValueEx(key, WIN_RUN_NAME)
            return True
    except OSError:
        return False


def win_start_background():
    if not win_background_running():
        subprocess.Popen(self_command("--background"), creationflags=NO_WINDOW | 0x00000008,  # DETACHED_PROCESS
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)


