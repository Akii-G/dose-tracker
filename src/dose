    @staticmethod
    def entry_row(lb, title, value, hint=""):
        row = Adw.ActionRow(title=title)
        entry = Gtk.Entry(text=value or "", placeholder_text=hint, valign=Gtk.Align.CENTER, hexpand=True,
                          width_chars=24)
        row.add_suffix(entry)
        lb.append(row)
        return entry

    def add_time(self, value):
        line = Gtk.Box(spacing=6)
        te = TimeEntry(value)
        line.append(te)
        rm = Gtk.Button(icon_name="list-remove-symbolic", tooltip_text=tr("Remove"))
        rm.add_css_class("flat")
        line.append(rm)
        self.time_entries.append(te)

        def remove(*_):
            if len(self.time_entries) > 1:
                self.time_entries.remove(te)
                self.times_box.remove(line)
        rm.connect("clicked", remove)
        self.times_box.append(line)

    def kind_key(self):
        return KINDS[self.kind.get_selected()][0]

    def update_kind(self):
        k = self.kind_key()
        self.days_row.set_visible(k == "weekdays")
        self.every_row.set_visible(k == "every")
        self.times_row.set_visible(k != "needed")
        self.add_time_row.set_visible(k != "needed")

    def update_stock(self):
        on = self.counted.get_active()
        self.count_row.set_visible(on)
        self.refill_row.set_visible(on)

    def on_search(self, entry):
        clear(self.results)
        found = search_medicines(entry.get_text(), 30)
        for name, strength, form, ingredient in found:
            row = Adw.ActionRow(title=GLib.markup_escape_text(name + (" " + strength if strength else "")),
                                subtitle=GLib.markup_escape_text(form + (" · " + ingredient if ingredient else "")),
                                activatable=True)
            row.found = (name, strength, form, ingredient)
            self.results.append(row)
        self.results.set_visible(bool(found))

    def on_result(self, _lb, row):
        name, strength, form, ingredient = row.found
        self.name.set_text(name)
        self.strength.set_text(strength)
        self.form.set_text(form)
        self.ingredient = ingredient
        low = form.lower()
        unit = ("drop" if "gocce" in low else "capsule" if "capsul" in low else "sachet" if "bustin" in low
                else "patch" if "cerott" in low else "ml" if any(w in low for w in ("sciroppo", "soluzione orale",
                "sospensione orale")) else "puff" if "inala" in low else "injection" if "iniett" in low else "pill")
        self.unit.set_selected(UNIT_KEYS.index(unit))
        self.search.set_text("")
        self.results.set_visible(False)

    def collect(self):
        name = self.name.get_text().strip()
        if not name:
            return None
        base = self.med or {"id": new_id(), "history": []}
        kind = self.kind_key()
        stock = None
        if self.counted.get_active():
            count = round(self.count.get_value(), 2)
            old = (self.med or {}).get("stock")
            if old and self.count_left is not None and abs(count - self.count_left) < 0.001:
                stock = old            # unchanged: keep counting from when it was set
            else:
                stock = {"count": count, "set": now_stamp()}
        return dict(base, name=name, strength=self.strength.get_text().strip(), form=self.form.get_text().strip(),
                    note=self.note.get_text().strip(), ingredient=self.ingredient,
                    amount=round(self.amount.get_value(), 2), unit=UNIT_KEYS[self.unit.get_selected()],
                    schedule={"kind": kind, "times": [t.get_value() for t in self.time_entries],
                              "weekdays": [i + 1 for i, b in enumerate(self.day_buttons) if b.get_active()],
                              "every": self.every.get_value_as_int(),
                              "start": (self.start.day or today()).isoformat(),
                              "end": self.end.day.isoformat() if self.has_end.get_active() and self.end.day else ""},
                    stock=stock, refillDays=self.refill.get_value_as_int())

    def on_save(self, *_):
        med = self.collect()
        if med is None:
            self.name.grab_focus()
            return
        self.win.change(lambda s: s.put_medicine(med))
        self.close()

    def on_archive(self, *_):
        archived = not self.med["archived"]
        self.win.change(lambda s: s.set_archived(self.med["id"], archived))
        self.close()

    def on_delete(self, *_):
        dialog = Gtk.Window(transient_for=self, modal=True, title=tr("Delete"), default_width=380)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=20, margin_bottom=20,
                      margin_start=20, margin_end=20)
        box.append(make_label(tr("Delete %s and every dose you marked for it? This can't be undone.") %
                              self.med["name"], wrap=True))
        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        no = Gtk.Button(label=tr("Cancel"))
        no.connect("clicked", lambda *_: dialog.close())
        yes = Gtk.Button(label=tr("Delete"))
        yes.add_css_class("destructive-action")

        def really(*_):
            self.win.change(lambda s: s.delete_medicine(self.med["id"]))
            dialog.close()
            self.close()
        yes.connect("clicked", really)
        buttons.append(no)
        buttons.append(yes)
        box.append(buttons)
        dialog.set_child(box)
        dialog.present()


